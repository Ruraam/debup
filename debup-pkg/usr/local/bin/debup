SYSTEM_LOCALE="${LC_ALL:-${LANG:-en}}"
USER_LANG="${SYSTEM_LOCALE%%_*}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"

SEARCH_HELPER="${SCRIPT_DIR}/../share/debup/search.sh"
if [ -f "$SEARCH_HELPER" ]; then
    # shellcheck source=/dev/null
    source "$SEARCH_HELPER"
fi

PACKAGE_VALIDATION_HELPER="${SCRIPT_DIR}/../share/debup/package_validation.sh"
if [ ! -r "$PACKAGE_VALIDATION_HELPER" ]; then
    printf 'Required package validation helper is missing: %s\n' "$PACKAGE_VALIDATION_HELPER" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$PACKAGE_VALIDATION_HELPER"

API_CACHE_HELPER="${SCRIPT_DIR}/../share/debup/api_cache.sh"
if [ ! -r "$API_CACHE_HELPER" ]; then
    printf 'Required API cache helper is missing: %s\n' "$API_CACHE_HELPER" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$API_CACHE_HELPER"

CONF_DIR="/etc/debup"
SOURCES_FILE="${CONF_DIR}/sources.list"

TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/debup.XXXXXX") || {
    printf 'Unable to create a secure temporary directory.\n' >&2
    exit 1
}
cleanup() {
    rm -rf -- "$TEMP_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

CACHE_API_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/debup/api"

if [ -d "/usr/local/share/debup/locales" ]; then
    LOCALE_DIR="/usr/local/share/debup/locales"
elif [ -d "/usr/share/debup/locales" ]; then
    LOCALE_DIR="/usr/share/debup/locales"
elif [ -d "${SCRIPT_DIR}/locales" ]; then
    LOCALE_DIR="${SCRIPT_DIR}/locales"
elif [ -d "${SCRIPT_DIR}/../share/debup/locales" ]; then
    LOCALE_DIR="${SCRIPT_DIR}/../share/debup/locales"
else
    LOCALE_DIR=""
fi

if [ -n "$LOCALE_DIR" ] && [ -f "${LOCALE_DIR}/en.sh" ]; then
    # shellcheck source=/dev/null
    source "${LOCALE_DIR}/en.sh"
fi

if [ -n "$LOCALE_DIR" ] && [ "$USER_LANG" != "en" ] && [ -f "${LOCALE_DIR}/${USER_LANG}.sh" ]; then
    # shellcheck source=/dev/null
    source "${LOCALE_DIR}/${USER_LANG}.sh"
fi

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
MAGENTA='\033[0;35m'
NC='\033[0m'

prompt_read() {
    local _var="$1"
    local _prompt="${2:-}"
    local _answer=""

    [ -n "$_prompt" ] && echo -en "$_prompt" >&2

    if [ -t 0 ]; then
        IFS= read -r _answer || _answer=""
    elif [ -e /dev/tty ] && [ -r /dev/tty ] && [ -w /dev/tty ]; then
        IFS= read -r _answer </dev/tty || _answer=""
    else
        echo -e "${YELLOW}⚠ ${MSG_NO_TTY:-Non-interactive mode: defaulting to 'n'.}${NC}" >&2
        printf -v "$_var" '%s' "n"
        return 1
    fi

    printf -v "$_var" '%s' "$_answer"
    return 0
}

normalize_gh_tag() {
    local tag="$1"
    local version=""

    version=$(printf '%s' "$tag" | sed -E 's/^[A-Za-z][A-Za-z0-9_-]*-//')
    version="${version#v}"

    if ! printf '%s' "$version" | grep -qE '^[0-9]'; then
        version="${tag#v}"
    fi

    version=$(printf '%s' "$version" | sed -E \
        's/-(linux|darwin|windows|freebsd|debian|ubuntu|osx|win)(-(amd64|arm64|x86_64|aarch64|i[3-6]86|armhf))?$//i')

    printf '%s' "$version"
}

show_banner() {
    echo -e "${BOLD}${RED}"
    cat << 'EOF'
           ********           
       ******    ******       
    ***** *****      *****    
   ****      *****     ****   
  *********      ***********  
  ***    *****  *****    ***  
  ***       ******       **   
  ***         **              
  ***         **         **** 
   ***        **   *** ****     _      _
    *****     **    *****      | | ___| |__  _   _ _ __
       ****** ** *    *     / _` |/ _ \ '_ \| | | | '_ \
           ********        | (_| |  __/ |_) | |_| | |_) |
                            \__,_|\___|_.__/ \__,_| .__/
                            Hybrid Package Manager|_|
EOF
    echo -e "${NC}"
}

if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
    DISTRO_PREF="ubuntu"
else
    DISTRO_PREF="debian"
fi

if [ "$(id -ru)" -eq 0 ]; then
    ELEVATE=""
elif command -v sudo >/dev/null 2>&1; then
    ELEVATE="sudo"
elif command -v doas >/dev/null 2>&1; then
    ELEVATE="doas"
else
    echo -e "${RED}${MSG_ERR_NO_ELEVATE:-Erreur: sudo ou doas requis.}${NC}" >&2
    exit 1
fi

missing=0
for cmd in curl jq dpkg dpkg-deb apt apt-get apt-cache apt-mark sha256sum awk; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf "${RED}%s : '%s' %s${NC}\n" "${MSG_ERR_PREFIX:-Error}" "$cmd" "${MSG_CMD_REQUIRED_SUFFIX:-is required.}" >&2
        missing=1
    fi
done
if [ "$missing" -eq 1 ]; then
    exit 1
fi

if [ ! -d "$CONF_DIR" ]; then
    $ELEVATE mkdir -p "$CONF_DIR" || {
        printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_CREATE_DIR" "$CONF_DIR")" >&2
        exit 1
    }
fi

if [ ! -f "$SOURCES_FILE" ]; then
    if ! $ELEVATE install -D -m 0644 /dev/null "$SOURCES_FILE"; then
        printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_CREATE_FILE" "$SOURCES_FILE")" >&2
        exit 1
    fi
fi

atomic_replace_sources() {
    local content_file="$1"
    local destination_tmp

    if [ ! -f "$content_file" ]; then
        echo -e "${RED}✖ Source-list staging file is missing.${NC}" >&2
        return 1
    fi

    destination_tmp=$($ELEVATE mktemp "${CONF_DIR}/.sources.list.XXXXXX") || {
        echo -e "${RED}✖ Failed to create a temporary source-list file.${NC}" >&2
        return 1
    }

    if ! $ELEVATE install -m 0644 "$content_file" "$destination_tmp"; then
        $ELEVATE rm -f -- "$destination_tmp" >/dev/null 2>&1 || true
        echo -e "${RED}✖ Failed to stage the updated source list.${NC}" >&2
        return 1
    fi

    if ! $ELEVATE mv -f -- "$destination_tmp" "$SOURCES_FILE"; then
        $ELEVATE rm -f -- "$destination_tmp" >/dev/null 2>&1 || true
        echo -e "${RED}✖ Failed to atomically replace $SOURCES_FILE.${NC}" >&2
        return 1
    fi
}

if ! ARCH=$(dpkg --print-architecture 2>/dev/null) || [ -z "$ARCH" ]; then
    echo -e "${RED}✖ Unable to determine the system architecture with dpkg.${NC}" >&2
    exit 1
fi

get_arch_regex() {
    case "$ARCH" in
        amd64) echo "(^|[-_.])(amd64|x86_64|x64|all)([-_.]|$)" ;;
        arm64) echo "(^|[-_.])(arm64|aarch64|arm64v8|all)([-_.]|$)" ;;
        armhf) echo "(^|[-_.])(armhf|armv7l|all)([-_.]|$)" ;;
        i386)  echo "(^|[-_.])(i[3-6]86|x86|all)([-_.]|$)" ;;
        *)     echo "(^|[-_.])(${ARCH}|all)([-_.]|$)" ;;
    esac
}

run_apt_styled() {
    local status=0
    $ELEVATE env DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 apt-get \
        -o Dpkg::Progress-Fancy="1" \
        -o APT::Color::Highlight="\e[32m" \
        "$@" 2>&1 | while IFS= read -r line; do
            case "$line" in
                Get:*|Hit:*|Ign:*)
                    echo -e "  ${GRAY}↓ ${line}${NC}"
                    ;;
                Reading*|Building*)
                    echo -e "  ${CYAN}⚙ ${MSG_APT_READING:-$line}${NC}"
                    ;;
                *Setting\ up*|*Processing*)
                    echo -e "  ${CYAN}⚙ ${MSG_APT_CONFIGURING:-$line}${NC}"
                    ;;
                *Unpacking*|*Preparing*)
                    echo -e "${YELLOW}▣ ${MSG_APT_UNPACKING:-$line}${NC}"
                    ;;
                *error*|*Error*|*E:*)
                    echo -e "  ${RED}✖ ${line}${NC}"
                    ;;
                *warning*|*Warning*|*W:*)
                    echo -e "  ${YELLOW}⚠ ${line}${NC}"
                    ;;
                Progress:*)
                    echo -en "\r  ${BLUE}::${NC} ${line}\r"
                    ;;
                *)
                    [ -n "$line" ] && echo -e "  ${GRAY}${line}${NC}"
                    ;;
            esac
        done
    status=${PIPESTATUS[0]}
    return "$status"
}

DRY_RUN=false
filtered_args=()
for arg in "$@"; do
    case "$arg" in
        -d|--dry-run)
            DRY_RUN=true
            ;;
        *)
            filtered_args+=("$arg")
            ;;
    esac
done
set -- "${filtered_args[@]}"

filter_compatible_debs() {
    local assets="$1"
    local arch_pattern
    arch_pattern=$(get_arch_regex)

    local filtered
    filtered=$(echo "$assets" | grep -iE "$arch_pattern")

    if [ "$ARCH" = "amd64" ]; then
        filtered=$(echo "$filtered" | grep -ivE "(^|[-_.])(arm|aarch64?)([-_.]|$)")
    elif [ "$ARCH" = "arm64" ]; then
        filtered=$(echo "$filtered" | grep -ivE "(^|[-_.])(x86|amd64|i[3-6]86)([-_.]|$)")
    fi

    filtered=$(echo "$filtered" | grep -vE "(-dbg|-dbgsym)" || true)

    echo "$filtered"
}

set_github_token() {
    local token="$1"

    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${YELLOW}Dry run: the GitHub token would be stored securely; no files will be changed.${NC}"
        return 0
    fi

    if [ -z "$token" ]; then
        if [ ! -t 0 ] && [ ! -e /dev/tty ]; then
            echo -e "${RED}${MSG_ERR_NO_TTY:-Aucun terminal disponible ; passez le token en argument : dbp token <PAT>}${NC}" >&2
            return 1
        fi
        echo -en "${CYAN}${MSG_ENTER_PAT:-Enter GitHub Personal Access Token: }${NC} "
        if [ -t 0 ]; then
            IFS= read -rs token || token=""
        else
            IFS= read -rs token </dev/tty || token=""
        fi
        echo ""
    fi

    if [ -z "$token" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${RED}${MSG_ERR_EMPTY_TOKEN:-Token cannot be empty.}${NC}"
        return 1
    fi

    # GitHub tokens are opaque ASCII credentials; reject whitespace and shell
    # metacharacters before writing the legacy shell-style configuration file.
    if [[ ! "$token" =~ ^[A-Za-z0-9_]+$ ]]; then
        echo -e "${RED}✖ Invalid token format; refusing to store unsafe characters.${NC}" >&2
        return 1
    fi

    local user_conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/debup"
    local user_tmp=""
    local root_tmp=""
    local old_umask
    old_umask=$(umask)
    umask 077

    if ! mkdir -p "$user_conf_dir" || ! chmod 700 "$user_conf_dir"; then
        umask "$old_umask"
        echo -e "${RED}✖ Unable to secure the user configuration directory.${NC}" >&2
        return 1
    fi
    user_tmp=$(mktemp "${user_conf_dir}/.token.XXXXXX") || {
        umask "$old_umask"
        echo -e "${RED}✖ Unable to create a temporary token file.${NC}" >&2
        return 1
    }
    if ! printf '%s\n' "$token" > "$user_tmp" ||
       ! chmod 600 "$user_tmp" ||
       ! mv -f -- "$user_tmp" "$user_conf_dir/token"; then
        rm -f -- "$user_tmp"
        umask "$old_umask"
        echo -e "${RED}✖ Unable to atomically store the user token.${NC}" >&2
        return 1
    fi

    if [ "$(id -ru)" -eq 0 ]; then
        if ! $ELEVATE mkdir -p "$CONF_DIR"; then
            umask "$old_umask"
            echo -e "${RED}✖ Unable to create the system configuration directory.${NC}" >&2
            return 1
        fi
        root_tmp=$($ELEVATE mktemp "${CONF_DIR}/.debup.conf.XXXXXX") || {
            umask "$old_umask"
            echo -e "${RED}✖ Unable to create a temporary system token file.${NC}" >&2
            return 1
        }
        if ! printf 'GITHUB_TOKEN="%s"\n' "$token" | $ELEVATE tee "$root_tmp" >/dev/null ||
           ! $ELEVATE chmod 600 "$root_tmp" ||
           ! $ELEVATE mv -f -- "$root_tmp" "$CONF_DIR/debup.conf"; then
            $ELEVATE rm -f -- "$root_tmp" 2>/dev/null || true
            umask "$old_umask"
            echo -e "${RED}✖ Unable to atomically store the system token.${NC}" >&2
            return 1
        fi
    fi

    umask "$old_umask"

    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${GREEN}${MSG_TOKEN_SUCCESS:-GitHub Token configured successfully.}${NC}"
}

USER_TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/debup/token"
if [ -z "$GITHUB_TOKEN" ]; then
    if [ -f "$USER_TOKEN_FILE" ]; then
        GITHUB_TOKEN=$(tr -d '[:space:]' < "$USER_TOKEN_FILE")
    elif [ -f "$CONF_DIR/debup.conf" ]; then
        GITHUB_TOKEN=$(grep -E '^GITHUB_TOKEN=' "$CONF_DIR/debup.conf" | cut -d'=' -f2- | tr -d '"'\''[:space:]')
    fi
fi

AUTH_HEADER=()
if [ -n "$GITHUB_TOKEN" ]; then
    AUTH_HEADER=(-H "Authorization: Bearer $GITHUB_TOKEN")
fi

debup_inspect() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${RED}${MSG_USAGE_INSPECT}${NC}"
        return 1
    fi

    local repo_path
    repo_path=$(echo "$target" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
    local api_url="repos/${repo_path}/releases/latest"

    printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_INSPECT_TITLE" "$repo_path")"

    local release_json
    if ! release_json=$(fetch_github_api "$api_url" 10); then
        printf "${RED}GitHub release metadata could not be retrieved; inspection aborted.\n${NC}" >&2
        return 1
    fi

    local deb_assets
    deb_assets=$(echo "$release_json" | jq -r '.assets[]?.name // empty' | grep -iE '\.deb$')
    local compat_debs
    compat_debs=$(filter_compatible_debs "$deb_assets")

    local chosen_deb=""
    if [ -n "$compat_debs" ]; then
        chosen_deb=$(echo "$compat_debs" | grep -i "$DISTRO_PREF" | head -n1)
        [ -z "$chosen_deb" ] && chosen_deb=$(echo "$compat_debs" | head -n1)
    fi

    if [ -z "$chosen_deb" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_NO_COMPAT_DEB" "$ARCH")"
        return 1
    fi

    if [[ "$chosen_deb" == */* || "$chosen_deb" == "." || "$chosen_deb" == ".." ]]; then
        echo -e "${RED}✖ Invalid Debian asset filename returned by GitHub.${NC}" >&2
        return 1
    fi

    local release_id
    release_id=$(jq -r '.id // empty' <<< "$release_json")
    if ! validate_release_asset_selection "$release_json" "$release_id" "$chosen_deb"; then
        echo -e "${RED}✖ The selected Debian asset does not belong to a valid, unique GitHub release asset entry.${NC}" >&2
        return 1
    fi

    local deb_urls deb_url_count deb_url
    deb_urls=$(jq -r --arg name "$chosen_deb" '[.assets[] | select(.name == $name) | .browser_download_url // empty] | .[]' <<< "$release_json") || return 1
    deb_url_count=$(printf '%s\n' "$deb_urls" | awk 'NF { count++ } END { print count+0 }')
    if [ "$deb_url_count" -ne 1 ]; then
        echo -e "${RED}✖ The selected Debian asset does not have exactly one download URL.${NC}" >&2
        return 1
    fi
    deb_url="$deb_urls"
    if [[ ! "$deb_url" =~ ^https://github\.com/[^[:space:]]+$ ]]; then
        echo -e "${RED}✖ The selected Debian asset has an invalid download URL.${NC}" >&2
        return 1
    fi

    local tmp_deb="$TEMP_DIR/inspect.deb"
    local inspect_dir="$TEMP_DIR/control_data"
    mkdir -p "$inspect_dir"

    echo -e "${GRAY}${MSG_INSPECT_DOWNLOADING}${NC}"
    if ! download_file_atomic "$deb_url" "$tmp_deb" 300 false; then
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${RED}${MSG_ERR_INSPECT_DL}${NC}"
        return 1
    fi

    if ! validate_deb_metadata "$tmp_deb" "$ARCH"; then
        echo -e "${RED}✖ Downloaded Debian package failed metadata validation; inspection aborted.${NC}" >&2
        rm -f -- "$tmp_deb"
        return 1
    fi

    if ! dpkg-deb -e "$tmp_deb" "$inspect_dir" 2>/dev/null; then
        echo -e "${RED}✖ Unable to extract the Debian control archive; inspection aborted.${NC}" >&2
        rm -f -- "$tmp_deb"
        return 1
    fi

    echo -e "${BLUE}---------------------------------------------------------${NC}"
    echo -e "${YELLOW}⚙  ${MSG_INSPECT_SCRIPTS}${NC}"
    echo -e "${BLUE}---------------------------------------------------------${NC}"

    local found_scripts=false
    for script in preinst postinst prerm postrm; do
        if [ -f "$inspect_dir/$script" ]; then
            found_scripts=true
            echo -e "\n${BOLD}${CYAN}=== Script: $script ===${NC}"
            cat -v "$inspect_dir/$script"
            echo -e "${CYAN}===================================${NC}"
        fi
    done

    if [ "$found_scripts" = false ]; then
        echo -e "${GREEN}✔ ${MSG_INSPECT_NO_SCRIPTS}${NC}"
    fi

    echo -e "\n${BLUE}---------------------------------------------------------${NC}"
    echo -e "${YELLOW}📁 ${MSG_INSPECT_FILES}${NC}"
    echo -e "${BLUE}---------------------------------------------------------${NC}"

    local file_listing
    if ! file_listing=$(dpkg-deb -c "$tmp_deb"); then
        echo -e "${RED}✖ Unable to read the Debian package file list.${NC}" >&2
        rm -f -- "$tmp_deb"
        return 1
    fi
    printf '%s\n' "$file_listing" | awk '{print $1, $2, $6}' | sed 's/^/  /'
    echo -e "${BLUE}---------------------------------------------------------${NC}"
}

install_apt_package() {
    local target="$1"
    local assume_yes="${2:-false}"
    local apt_plan
    local -a apt_args=()

    if [ -z "$target" ]; then
        echo -e "${RED}✖ No APT package target was provided.${NC}" >&2
        return 1
    fi

    if [ "$DRY_RUN" = "true" ]; then
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_APT_INSTALL" "$target")"
        return 0
    fi

    if ! apt_plan=$($ELEVATE env LC_ALL=C apt-get --simulate install "$target" 2>&1); then
        echo -e "${RED}✖ APT could not resolve the requested package transaction; installation aborted.${NC}" >&2
        printf '%s\n' "$apt_plan" >&2
        return 1
    fi
    if apt_plan_has_removals "$apt_plan"; then
        echo -e "${RED}✖ APT would remove or purge installed packages; refusing this transaction.${NC}" >&2
        printf '%s\n' "$apt_plan" | awk '$1 == "Remv" || $1 == "Purg" { print }' >&2
        return 1
    fi

    apt_args=(--no-remove install)
    [ "$assume_yes" = "true" ] && apt_args+=("-y")
    apt_args+=("$target")
    run_apt_styled "${apt_args[@]}"
}

check_and_update() {
    local REPO_URL="$1"
    local PKG_NAME="$2"
    local ASSUME_YES="$3"
    local EXPECTED_RELEASE_ID="${4:-}"
    local EXPECTED_ASSET="${5:-}"

    if [ -n "$PKG_NAME" ] && apt-mark showhold 2>/dev/null | grep -qx "$PKG_NAME"; then
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_PINNED_SKIPPED" "${CYAN}${PKG_NAME}${NC}")"
        return 2
    fi

    local api_url
    local tag=""
    local repo_path

    if [[ "$REPO_URL" == *"@"* ]]; then
        tag="${REPO_URL##*@}"
        REPO_URL="${REPO_URL%@*}"
    fi

    if [[ "$REPO_URL" == *"api.github.com"* ]]; then
        repo_path=$(echo "$REPO_URL" | sed -E 's#^https?://api\.github\.com/repos/##; s#/$##')
    else
        repo_path=$(echo "$REPO_URL" | sed -E 's#^https?://github\.com/##; s#/$##; s#\\.git$##')
    fi

    if [[ ! "$repo_path" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
        echo -e "${RED}✖ Invalid GitHub repository identifier.${NC}" >&2
        return 1
    fi

    if [[ -n "$EXPECTED_RELEASE_ID" ]]; then
        if [[ ! "$EXPECTED_RELEASE_ID" =~ ^[1-9][0-9]*$ ]]; then
            echo -e "${RED}✖ Invalid selected GitHub release identifier.${NC}" >&2
            return 1
        fi
        api_url="repos/${repo_path}/releases/${EXPECTED_RELEASE_ID}"
    elif [ -n "$tag" ]; then
        local encoded_tag
        encoded_tag=$(printf '%s' "$tag" | jq -sRr @uri) || return 1
        api_url="repos/${repo_path}/releases/tags/${encoded_tag}"
    else
        api_url="repos/${repo_path}/releases/latest"
    fi

    local release_json
    if ! release_json=$(fetch_github_api "$api_url" 30); then
        echo -e "${RED}✖ Unable to retrieve the selected GitHub release.${NC}" >&2
        return 1
    fi
    if ! jq -e --arg expected_id "$EXPECTED_RELEASE_ID" '
        type == "object" and
        (.tag_name | type == "string" and length > 0 and (test("[[:cntrl:]]") | not)) and
        (.assets | type == "array") and
        ($expected_id == "" or ((.id | tostring) == $expected_id))
    ' >/dev/null 2>&1 <<< "$release_json"; then
        echo -e "${RED}✖ GitHub returned invalid or mismatched release metadata.${NC}" >&2
        return 1
    fi


    local latest_tag
    latest_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')

    if [ -z "$latest_tag" ]; then
        local error_message
        error_message=$(echo "$release_json" | jq -r '.message // empty' 2>/dev/null)

        echo -e "${BLUE}---------------------------------------${NC}"
        printf "${RED}%b${NC} ${CYAN}%s${NC}\n" "$(printf "$MSG_ERR_FETCH_RELEASE" "")" "${repo_path:-$REPO_URL}"

        if [ -n "$error_message" ]; then
            echo -e "${BLUE}---------------------------------------${NC}"
            printf "${RED}%b${NC} ${CYAN}%s${NC}\n" "$(printf "$MSG_ERR_GH_API" "")" "${error_message}"
        fi
        return 1
    fi

    local remote_ver
    remote_ver=$(normalize_gh_tag "$latest_tag")

    local local_ver=""
    if [ -n "$PKG_NAME" ]; then
        local_ver=$(dpkg-query -W -f='${Version}' "$PKG_NAME" 2>/dev/null | tr -d '\r')
    fi
    local_ver=$(normalize_gh_tag "$local_ver")

    echo -e "${YELLOW}${MSG_PACKAGE_HEADER}${NC}"
    echo -e "${PKG_NAME:-$MSG_NEW_PACKAGE} ${CYAN}${local_ver:-$MSG_NOT_INSTALLED}${NC} ${GRAY}(${repo_path:-$REPO_URL})${NC}"
    printf "${GREEN}%b${NC}\n" "$(printf "$MSG_LATEST_VERSION" "$remote_ver")"

    if [ -n "$local_ver" ] && [ -n "$remote_ver" ] && dpkg --compare-versions "$local_ver" ge "$remote_ver" 2>/dev/null; then
        echo -e "${GREEN}${MSG_ALREADY_UP_TO_DATE}${NC}"
        echo
        echo -e "${BLUE}---------------------------------------${NC}"
        return 2
    fi

    local deb_assets
    deb_assets=$(jq -r '.assets[]? | select(.name | type == "string") | .name | select(test("\\.deb$"; "i"))' <<< "$release_json")
    local compat_debs
    compat_debs=$(filter_compatible_debs "$deb_assets")

    if [ -z "$compat_debs" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_NO_COMPAT_DEB" "$ARCH")"
        return 1
    fi

    local chosen_deb=""
    if [ -n "$EXPECTED_ASSET" ]; then
        if ! jq -e --arg name "$EXPECTED_ASSET" '[.assets[] | select(.name == $name)] | length == 1' >/dev/null 2>&1 <<< "$release_json"; then
            echo -e "${RED}✖ The selected asset is missing or ambiguous in the selected release.${NC}" >&2
            return 1
        fi
        if [[ ! "$EXPECTED_ASSET" =~ ^[A-Za-z0-9][A-Za-z0-9+_.-]*\.deb$ || "$EXPECTED_ASSET" == *".."* ]] ||
           ! grep -Fxq -- "$EXPECTED_ASSET" <<< "$compat_debs"; then
            echo -e "${RED}✖ The selected asset is not a safe, architecture-compatible Debian package.${NC}" >&2
            return 1
        fi
        chosen_deb="$EXPECTED_ASSET"
    else
        chosen_deb=$(select_compatible_deb_asset "$compat_debs" "$DISTRO_PREF") || {
            echo -e "${RED}✖ No safe compatible Debian asset could be selected.${NC}" >&2
            return 1
        }
    fi


    local deb_urls deb_url_count deb_url
    deb_urls=$(jq -r --arg name "$chosen_deb" '[.assets[] | select(.name == $name) | .browser_download_url // empty] | .[]' <<< "$release_json") || {
        echo -e "${RED}✖ Unable to parse the selected Debian asset URL.${NC}" >&2
        return 1
    }
    deb_url_count=$(printf '%s\n' "$deb_urls" | awk 'NF { count++ } END { print count+0 }')
    if [ "$deb_url_count" -ne 1 ]; then
        echo -e "${RED}✖ The selected Debian asset does not have exactly one download URL.${NC}" >&2
        return 1
    fi
    deb_url="$deb_urls"
    if [[ ! "$deb_url" =~ ^https://[^[:space:]]+$ ]]; then
        echo -e "${RED}✖ The selected Debian asset has an invalid download URL.${NC}" >&2
        return 1
    fi

    local checksum_names checksum_assets checksum_url checksum_count
    checksum_names=$(jq -r --arg n "$chosen_deb" '[.assets[] | select(.name == ($n + ".sha256") or .name == ($n + ".sha256sum")) | .name] | .[]' <<< "$release_json") || {
        echo -e "${RED}✖ Unable to parse checksum asset metadata.${NC}" >&2
        return 1
    }
    checksum_count=$(printf '%s\n' "$checksum_names" | awk 'NF { count++ } END { print count+0 }')

    if [ "$checksum_count" -eq 0 ]; then
        checksum_names=$(jq -r '[.assets[] | select(.name | test("^(SHA256SUMS|sha256sums|checksums\\.txt)$"; "i")) | .name] | .[]' <<< "$release_json") || {
            echo -e "${RED}✖ Unable to parse checksum manifest metadata.${NC}" >&2
            return 1
        }
        checksum_count=$(printf '%s\n' "$checksum_names" | awk 'NF { count++ } END { print count+0 }')
    fi

    if [ "$checksum_count" -gt 1 ]; then
        echo -e "${RED}✖ Multiple checksum assets are ambiguous for this release.${NC}" >&2
        return 1
    fi

    checksum_url=""
    if [ "$checksum_count" -eq 1 ]; then
        checksum_assets=$(jq -r --arg n "$checksum_names" '[.assets[] | select(.name == $n) | .browser_download_url // empty] | .[]' <<< "$release_json") || {
            echo -e "${RED}✖ Unable to parse checksum download URL.${NC}" >&2
            return 1
        }
        local checksum_url_count
        checksum_url_count=$(printf '%s\n' "$checksum_assets" | awk 'NF { count++ } END { print count+0 }')
        if [ "$checksum_url_count" -ne 1 ]; then
            echo -e "${RED}✖ Published checksum asset has no unique download URL.${NC}" >&2
            return 1
        fi
        checksum_url="$checksum_assets"
        if [[ ! "$checksum_url" =~ ^https://github\.com/[^[:space:]]+$ ]]; then
            echo -e "${RED}✖ The checksum asset has an invalid download URL.${NC}" >&2
            return 1
        fi
    fi

    if [ "$DRY_RUN" = "true" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        if [ "$latest_tag" != "$remote_ver" ]; then
            printf "${GRAY}ℹ ${MSG_VERSION_NORMALIZED:-Version normalized: %s → %s}${NC}\n" "$latest_tag" "$remote_ver"
        fi
        printf "${YELLOW}%b${NC} ${GRAY}%s${NC}\n" "$(printf "$MSG_DRY_WOULD_DOWNLOAD" "")" "${deb_url}"
        printf "${YELLOW}%b${NC} ${CYAN}%s${NC} ${GREEN}(%s)${NC}\n" "$(printf "$MSG_DRY_WOULD_INSTALL" "" "")" "${PKG_NAME:-$chosen_deb}" "${latest_tag}"
        echo -e "${BLUE}---------------------------------------${NC}"
        return 0
    fi

    if [ "$ASSUME_YES" != "true" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${CYAN}${MSG_PROMPT_CONFIRM_INSTALL}${NC}"
        local confirm=""
        prompt_read confirm "" || true
        if [[ ! "$confirm" =~ ^[oOyY]$ ]]; then
            echo -e "${BLUE}---------------------------------------${NC}"
            echo -e "${RED}${MSG_OP_CANCELED}${NC}"
            return 3
        fi
    fi

    local deb_filename="$chosen_deb"
    local tmp_deb="$TEMP_DIR/$deb_filename"

    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${YELLOW}%b${NC} ${GRAY}%s${NC}\n" "$(printf "$MSG_DOWNLOADING" "")" "${deb_url}"
    if ! download_file_atomic "$deb_url" "$tmp_deb" 300 true; then
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${RED}${MSG_ERR_DOWNLOAD_FAILED}${NC}\n"
        rm -f -- "$tmp_deb"
        return 1
    fi

    if ! validate_deb_metadata "$tmp_deb" "$ARCH" "$PKG_NAME"; then
        echo -e "${RED}✖ Downloaded Debian package failed metadata validation; installation aborted.${NC}" >&2
        rm -f -- "$tmp_deb"
        return 1
    fi
    local deb_arch="$DEB_VALIDATED_ARCHITECTURE"
    local deb_pkg="$DEB_VALIDATED_PACKAGE"

    if ! deb_version_matches_release_floor "$DEB_VALIDATED_VERSION" "$remote_ver"; then
        printf "${RED}Downloaded package version %s is older than the GitHub release tag %s; refusing installation.\n${NC}" \
            "$DEB_VALIDATED_VERSION" "$latest_tag" >&2
        rm -f -- "$tmp_deb"
        return 1
    fi

    if [ -n "$checksum_url" ]; then
        echo -e "${BLUE}::${NC} ${CYAN}${MSG_VERIFYING_CHECKSUM}${NC}"
        local tmp_hash_file="$TEMP_DIR/checksums.txt"
        if ! download_file_atomic "$checksum_url" "$tmp_hash_file" 30 false; then
            echo -e "${RED}✖ Published checksum asset could not be downloaded; refusing installation.${NC}" >&2
            rm -f -- "$tmp_deb" "$tmp_hash_file"
            return 1
        fi
        if ! verify_deb_sha256 "$tmp_deb" "$tmp_hash_file" "$deb_filename"; then
            echo -e "${RED}✖ Published checksum verification failed; refusing installation.${NC}" >&2
            rm -f -- "$tmp_deb" "$tmp_hash_file"
            return 1
        fi
        echo -e "${GREEN}✔ ${MSG_CHECKSUM_SUCCESS}${NC}"
        rm -f -- "$tmp_hash_file"
    else
        echo -e "${YELLOW}ℹ No checksum asset published by this release; proceeding without publisher checksum.${NC}"
    fi

    local held_packages
    if ! held_packages=$(apt-mark showhold 2>/dev/null); then
        echo -e "${RED}✖ Unable to verify APT package holds; installation aborted.${NC}" >&2
        rm -f -- "$tmp_deb"
        return 1
    fi
    if grep -Fxq -- "$deb_pkg" <<< "$held_packages"; then
        printf "${YELLOW}Package %s is held; refusing to change its version.\n${NC}" "$deb_pkg" >&2
        rm -f -- "$tmp_deb"
        return 2
    fi

    local installed_package_version=""
    if installed_package_version=$(dpkg-query -W -f='${Version}' "$deb_pkg" 2>/dev/null) &&
       [ -n "$installed_package_version" ] &&
       deb_version_is_not_newer "$DEB_VALIDATED_VERSION" "$installed_package_version"; then
        printf "${GREEN}Package %s is already installed at version %s; downloaded version %s is not newer.\n${NC}" \
            "$deb_pkg" "$installed_package_version" "$DEB_VALIDATED_VERSION"
        rm -f -- "$tmp_deb"
        return 2
    fi

    if [ "$ASSUME_YES" != "true" ]; then
        local check_scripts=()
        for s in preinst postinst prerm postrm; do
            if dpkg-deb -e "$tmp_deb" "$TEMP_DIR/inspect_tmp" 2>/dev/null && [ -f "$TEMP_DIR/inspect_tmp/$s" ]; then
                check_scripts+=("$s")
            fi
        done
        rm -rf "$TEMP_DIR/inspect_tmp" 2>/dev/null

        if [ "${#check_scripts[@]}" -gt 0 ]; then
            printf "${YELLOW}%b${NC}\n" "$(printf "${MSG_PROMPT_ROOT_SCRIPTS_WARN:-⚠ Root scripts detected: %s}" "${check_scripts[*]}")"
            local view_scripts=""
            prompt_read view_scripts "${MSG_PROMPT_INSPECT_SCRIPTS:-Inspect them before install? [y/N]: }" || true
            if [[ "$view_scripts" =~ ^[oOyY]$ ]]; then
                local inspect_tmp="$TEMP_DIR/inspect_view"
                mkdir -p "$inspect_tmp"
                dpkg-deb -e "$tmp_deb" "$inspect_tmp" 2>/dev/null
                for s in "${check_scripts[@]}"; do
                    echo -e "\n${BOLD}${CYAN}=== Script: $s ===${NC}"
                    cat -v "$inspect_tmp/$s"
                    echo -e "${CYAN}=========================${NC}"
                done
                rm -rf "$inspect_tmp"

                local confirm_post_inspect=""
                prompt_read confirm_post_inspect "${MSG_PROMPT_CONFIRM_AFTER_INSPECT:-Confirm install? [y/N]: }" || true
                if [[ ! "$confirm_post_inspect" =~ ^[oOyY]$ ]]; then
                    echo -e "${BLUE}---------------------------------------${NC}"
                    echo -e "${RED}${MSG_OP_CANCELED}${NC}"
                    rm -f "$tmp_deb"
                    return 3
                fi
            fi
        fi
    fi

    if [ -z "$PKG_NAME" ]; then
        PKG_NAME="$deb_pkg"
    fi

    local apt_plan
    if ! apt_plan=$($ELEVATE env LC_ALL=C apt-get --simulate install "$tmp_deb" 2>&1); then
        echo -e "${RED}✖ APT could not resolve the requested package transaction; installation aborted.${NC}" >&2
        printf '%s\n' "$apt_plan" >&2
        rm -f -- "$tmp_deb"
        return 1
    fi
    if apt_plan_has_removals "$apt_plan"; then
        echo -e "${RED}✖ APT would remove or purge installed packages; refusing this transaction.${NC}" >&2
        printf '%s\n' "$apt_plan" | awk '$1 == "Remv" || $1 == "Purg" { print }' >&2
        rm -f -- "$tmp_deb"
        return 1
    fi

    echo -e "${YELLOW}${MSG_INSTALLING_PKG}${NC}"
    if $ELEVATE env DEBIAN_FRONTEND=noninteractive apt-get --no-remove install -y "$tmp_deb"; then
        rm -f "$tmp_deb"
        echo -e "${BLUE}---------------------------------------${NC}"
        printf "${GREEN}%b${NC}\n\n" "$(printf "$MSG_SUCCESS_INSTALLED" "${PKG_NAME}" "${latest_tag}")"

        if [ -n "$PKG_NAME" ] && ! awk -F'|' -v package="$PKG_NAME" '$1 == package { found = 1 } END { exit !found }' "$SOURCES_FILE"; then
            local tmp_sources
            tmp_sources=$(mktemp "${TEMP_DIR}/sources.XXXXXX") || {
                echo -e "${RED}✖ Failed to create a source-list staging file.${NC}" >&2
                return 1
            }

            if ! cat "$SOURCES_FILE" > "$tmp_sources"; then
                rm -f -- "$tmp_sources"
                echo -e "${RED}✖ Failed to read the existing source list.${NC}" >&2
                return 1
            fi
            if ! printf '%s|%s\n' "$PKG_NAME" "$repo_path" >> "$tmp_sources"; then
                rm -f -- "$tmp_sources"
                echo -e "${RED}✖ Failed to stage the package tracking entry.${NC}" >&2
                return 1
            fi
            if ! atomic_replace_sources "$tmp_sources"; then
                rm -f -- "$tmp_sources"
                echo -e "${RED}✖ Package installed, but its update tracking entry could not be saved.${NC}" >&2
                return 1
            fi
            rm -f -- "$tmp_sources"
        fi
        return 0
    else
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${RED}${MSG_ERR_INSTALL_FAILED}${NC}\n"
        rm -f "$tmp_deb"
        return 1
    fi
}

debup_search() {
    local query="$*"
    if [ -z "$query" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${RED}${MSG_USAGE_SEARCH}${NC}"
        return 1
    fi

    local gh_query
    gh_query=$(printf '%s in:name' "$query" | jq -sRr @uri) || {
        echo -e "${RED}✖ Failed to encode the GitHub search query.${NC}" >&2
        return 1
    }

    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_SEARCHING_GH" "$query")"

    local -a global_targets=()
    local -a global_types=()
    local -a global_release_ids=()
    local -a global_assets=()
    local -a global_expected_packages=()
    local display_idx=1
    local apt_results=""
    local apt_search_failed=false

    echo -e "\n${MAGENTA}${BOLD}[ Debian / APT ]${NC}"
    echo -e "${BLUE}---------------------------------------------------------${NC}"

    if ! apt_results=$(apt-cache search "$query" 2>/dev/null); then
        apt_search_failed=true
        apt_results=""
    fi
    apt_results=$(printf '%s\n' "$apt_results" | awk 'NR <= 5')

    if [ -n "$apt_results" ]; then
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            local apt_pkg apt_desc
            read -r apt_pkg apt_desc <<< "$line"
            [[ "$apt_pkg" =~ ^[a-z0-9][a-z0-9+.-]*$ ]] || continue

            global_targets[display_idx]="$apt_pkg"
            global_types[display_idx]="APT"
            global_release_ids[display_idx]=""
            global_assets[display_idx]=""
            global_expected_packages[display_idx]=""

            printf "${YELLOW}[%d]${NC} ${BOLD}%-35s${NC} ${GRAY}(APT)${NC}\n     ${GRAY}%s${NC}\n" \
                "$display_idx" "$apt_pkg" "${apt_desc:0:70}"
            display_idx=$((display_idx + 1))
        done <<< "$apt_results"
    elif [ "$apt_search_failed" = true ]; then
        echo -e " ${YELLOW}APT search is currently unavailable.${NC}"
    else
        echo -e " ${GRAY}${MSG_SEARCH_NO_APT}${NC}"
    fi

    echo -e "\n${GREEN}${BOLD}[ GitHub Releases ]${NC}"
    echo -e "${BLUE}---------------------------------------------------------${NC}"

    local -a candidate_repos=()
    local -a candidate_stars=()
    local -a candidate_descs=()
    local -a candidate_expected_packages=()
    local -A seen_repos=()
    local catalog_file="${SCRIPT_DIR}/../share/debup/curated_db.txt"
    local catalog_entries=""

    if declare -F catalog_search_repositories >/dev/null 2>&1; then
        catalog_entries=$(catalog_search_repositories "$catalog_file" "$query") || catalog_entries=""
    fi

    local catalog_repo catalog_package catalog_expected_package repo_key
    while IFS='|' read -r catalog_repo catalog_package catalog_expected_package; do
        [ -n "$catalog_repo" ] || continue
        repo_key="${catalog_repo,,}"
        [ -n "${seen_repos[$repo_key]+present}" ] && continue
        seen_repos[$repo_key]=1
        candidate_repos+=("$catalog_repo")
        candidate_stars+=("-")
        candidate_descs+=("Curated package: $catalog_package")
        candidate_expected_packages+=("$catalog_expected_package")
    done <<< "$catalog_entries"

    local raw_results=""
    local github_search_failed=false
    if raw_results=$(fetch_github_api "search/repositories?q=${gh_query}&sort=stars&order=desc&per_page=10" 10); then
        if jq -e 'type == "object" and (.items | type == "array")' >/dev/null 2>&1 <<< "$raw_results"; then
            local -a github_items=()
            mapfile -t github_items < <(jq -c '
                .items[]?
                | select(.full_name | type == "string")
                | {
                    full_name: .full_name,
                    stars: (if (.stargazers_count | type) == "number" and .stargazers_count >= 0 then (.stargazers_count | tostring) else "0" end),
                    description: (if (.description | type) == "string" then (.description | gsub("[\\u0000-\\u001F\\u007F]"; " ")) else "" end)
                  }
            ' <<< "$raw_results")

            local candidate_record
            for candidate_record in "${github_items[@]}"; do
                local repo_name stars description
                repo_name=$(jq -r '.full_name' <<< "$candidate_record")
                [[ "$repo_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || continue
                repo_key="${repo_name,,}"
                [ -n "${seen_repos[$repo_key]+present}" ] && continue
                seen_repos[$repo_key]=1
                stars=$(jq -r '.stars' <<< "$candidate_record")
                description=$(jq -r '.description' <<< "$candidate_record")
                candidate_repos+=("$repo_name")
                candidate_stars+=("$stars")
                candidate_descs+=("$description")
                candidate_expected_packages+=("")
            done
        else
            github_search_failed=true
        fi
    else
        github_search_failed=true
    fi

    if [ "${#candidate_repos[@]}" -eq 0 ]; then
        if [ "$github_search_failed" = true ]; then
            echo -e " ${YELLOW}GitHub search is currently unavailable.${NC}"
        else
            printf " ${GRAY}%b${NC}\n" "$(printf "$MSG_NO_REPOS_FOUND" "$query")"
        fi
    else
        if [ "$github_search_failed" = true ]; then
            echo -e " ${YELLOW}GitHub search API unavailable; checking curated entries only.${NC}"
        fi
        echo -e "${GRAY}${MSG_VERIFYING_DEBS}${NC}"

        local gh_valid=0
        local release_check_failed=0
        local candidate_index=0
        local candidate_repo candidate_stars_value candidate_desc candidate_expected_package check_release deb_assets compatible_debs chosen_asset release_id release_tag

        for candidate_repo in "${candidate_repos[@]}"; do
            candidate_stars_value="${candidate_stars[$candidate_index]}"
            candidate_desc="${candidate_descs[$candidate_index]}"
            candidate_expected_package="${candidate_expected_packages[$candidate_index]}"
            candidate_index=$((candidate_index + 1))

            if ! check_release=$(fetch_github_api "repos/${candidate_repo}/releases/latest" 10); then
                release_check_failed=$((release_check_failed + 1))
                continue
            fi
            if ! jq -e '
                type == "object" and
                (.id | type == "number" and . > 0) and
                (.tag_name | type == "string" and length > 0 and (test("[[:cntrl:]]") | not)) and
                (.assets | type == "array")
            ' >/dev/null 2>&1 <<< "$check_release"; then
                release_check_failed=$((release_check_failed + 1))
                continue
            fi

            release_id=$(jq -r '.id' <<< "$check_release")
            release_tag=$(jq -r '.tag_name' <<< "$check_release")
            deb_assets=$(jq -r '.assets[]? | select(.name | type == "string") | .name | select(test("\\.deb$"; "i"))' <<< "$check_release")
            compatible_debs=$(filter_compatible_debs "$deb_assets")
            chosen_asset=$(select_compatible_deb_asset "$compatible_debs" "$DISTRO_PREF") || chosen_asset=""
            if [ -n "$chosen_asset" ] && ! validate_release_asset_selection "$check_release" "$release_id" "$chosen_asset"; then
                chosen_asset=""
                release_check_failed=$((release_check_failed + 1))
            fi

            if [ -n "$chosen_asset" ]; then
                global_targets[display_idx]="$candidate_repo"
                global_types[display_idx]="GH"
                global_release_ids[display_idx]="$release_id"
                global_assets[display_idx]="$chosen_asset"
                global_expected_packages[display_idx]="$candidate_expected_package"

                if [ "$candidate_stars_value" = "-" ]; then
                    printf " ${YELLOW}[%d]${NC} ${BOLD}%-35s${NC} ${CYAN}(curated)${NC}\n     ${GRAY}%s${NC}\n" \
                        "$display_idx" "$candidate_repo" "${candidate_desc:0:70}"
                else
                    printf " ${YELLOW}[%d]${NC} ${BOLD}%-35s${NC} ${YELLOW}★ %-6s${NC}\n     ${GRAY}%s${NC}\n" \
                        "$display_idx" "$candidate_repo" "$candidate_stars_value" "${candidate_desc:0:70}"
                fi
                printf "     ${CYAN}Release %s — %s${NC}\n" "$release_tag" "$chosen_asset"

                display_idx=$((display_idx + 1))
                gh_valid=$((gh_valid + 1))
                [ "$gh_valid" -ge 5 ] && break
            fi
        done

        if [ "$gh_valid" -eq 0 ]; then
            if [ "$release_check_failed" -gt 0 ]; then
                printf " ${YELLOW}GitHub release verification was incomplete; no package was selected.${NC}\n" >&2
            else
                printf " ${GRAY}%b${NC}\n" "$(printf "$MSG_NO_DEB_IN_REPOS" "$query")"
            fi
        elif [ "$release_check_failed" -gt 0 ]; then
            printf " ${YELLOW}%d repository/repositories could not be verified; the displayed candidates were checked successfully.${NC}\n" "$release_check_failed" >&2
        fi
    fi

    local total_options=$((display_idx - 1))
    echo -e "${BLUE}---------------------------------------------------------${NC}"

    if [ "$total_options" -eq 0 ]; then
        echo -e "${YELLOW}${MSG_SEARCH_NO_RESULTS}${NC}"
        return 0
    fi

    local raw_input=""
    prompt_read raw_input "${MSG_PROMPT_SELECT_NUM:-Enter package numbers (e.g. 1 2 3 or 1-3) [default: cancel]: }" || raw_input=""
    [ -z "$raw_input" ] && { echo -e "${CYAN}${MSG_OP_CANCELED}${NC}"; return 0; }

    local selected_output
    if ! selected_output=$(parse_search_selection "$raw_input" "$total_options"); then
        echo -e "${RED}Invalid selection. Use only displayed numbers and valid ranges (for example: 1 2, 1,2, or 1-3). No packages were installed.${NC}" >&2
        return 2
    fi

    local -a unique_indices=()
    mapfile -t unique_indices <<< "$selected_output"

    local choice selected_target selected_type install_failed=0
    for choice in "${unique_indices[@]}"; do
        selected_target="${global_targets[choice]}"
        selected_type="${global_types[choice]}"

        echo -e "${BLUE}---------------------------------------${NC}"

        if [ "$selected_type" = "APT" ]; then
            printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_APT_INSTALLING" "${BOLD}${selected_target}${NC}${CYAN}")"
            if ! install_apt_package "$selected_target" true; then
                install_failed=1
                printf "${RED}✖ APT package installation failed: %s${NC}\n" "$selected_target" >&2
            fi
        else
            local selected_repo="$selected_target"
            local selected_release_id="${global_release_ids[choice]}"
            local selected_asset="${global_assets[choice]}"
            local selected_expected_package="${global_expected_packages[choice]}"
            printf "${CYAN}%b${NC} ${GREEN}%s${NC}...\n" "$(printf "$MSG_INSPECTING_ASSETS" "")" "$selected_repo"
            printf "${CYAN}Selected release ID: %s; asset: %s${NC}\n" "$selected_release_id" "$selected_asset"

            check_and_update "$selected_repo" "$selected_expected_package" false "$selected_release_id" "$selected_asset"
            local selected_install_status=$?
            if [ "$selected_install_status" -eq 1 ]; then
                install_failed=1
            fi
        fi
    done

    return "$install_failed"
}

debup_info() {
    local target="$1"
    if [ -z "$target" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e "${RED}${MSG_USAGE_INFO}${NC}"
        return 1
    fi

    target=$(echo "$target" | sed -e 's|https://github.com/||g' -e 's|/$||')

    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_FETCHING_METADATA" "${GREEN}${target}${CYAN}")"

    local repo_data
    if ! repo_data=$(fetch_github_api "repos/${target}" 30); then
        printf "${RED}GitHub repository metadata could not be retrieved; no cached fallback was used.\n${NC}" >&2
        return 1
    fi

    local not_found
    not_found=$(echo "$repo_data" | jq -r '.message // empty' 2>/dev/null)
    if [ "$not_found" = "Not Found" ]; then
        printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_REPO_NOT_FOUND" "$target")"
        return 1
    fi

    local release_data
    if ! release_data=$(fetch_github_api "repos/${target}/releases/latest" 15); then
        printf "${RED}GitHub release metadata could not be retrieved.\n${NC}" >&2
        return 1
    fi

    local tag_name
    tag_name=$(echo "$release_data" | jq -r '.tag_name // empty' 2>/dev/null)
    if [ -z "$tag_name" ]; then
        echo -e "${YELLOW}${MSG_WARN_NO_RELEASES}${NC}"
        return 1
    fi

    local description stars license published_at deb_assets
    description=$(echo "$repo_data" | jq -r --arg def "$MSG_INFO_NO_DESC" '.description // $def')
    stars=$(echo "$repo_data" | jq -r '.stargazers_count')
    license=$(echo "$repo_data" | jq -r --arg def "$MSG_INFO_NONE" '.license.spdx_id // $def')
    published_at=$(echo "$release_data" | jq -r '.published_at' | cut -d'T' -f1)
    deb_assets=$(echo "$release_data" | jq -r '.assets[]?.name // empty' 2>/dev/null | grep -iE '\.deb$')

    local matching_deb
    matching_deb=$(filter_compatible_debs "$deb_assets")

    echo -e "${BLUE}---------------------------------------${NC}"
    printf " ${BOLD}${CYAN}%-14s${NC} %s\n" "$MSG_INFO_PKG" "$target"
    printf " ${BOLD}${CYAN}%-14s${NC} ${GREEN}%s${NC} (%s)\n" "$MSG_INFO_LATEST" "$tag_name" "$published_at"
    printf " ${BOLD}${CYAN}%-14s${NC} ${YELLOW}★ %s${NC}\n" "$MSG_INFO_STARS" "$stars"
    printf " ${BOLD}${CYAN}%-14s${NC} %s\n" "$MSG_INFO_LICENSE" "$license"
    printf " ${BOLD}${CYAN}%-14s${NC} %s\n" "$MSG_INFO_DESC" "$description"
    echo -e "${BLUE}---------------------------------------${NC}"

    if [ -n "$matching_deb" ]; then
        printf " ${BOLD}${CYAN}%b${NC}\n" "$(printf "$MSG_INFO_COMPAT_DEBS" "$ARCH")"
        echo "$matching_deb" | sed 's/^/   • /'
    elif [ -n "$deb_assets" ]; then
        echo -e "${BLUE}---------------------------------------${NC}"
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_WARN_NO_ARCH_DEBS" "$ARCH")"
        echo "$deb_assets" | sed 's/^/   • /'
    else
        echo -e "${BLUE}---------------------------------------${NC}"
        echo -e " ${RED}${MSG_ERR_NO_DEB_IN_REL}${NC}"
    fi
}

debup_check_updates() {
    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPDATE_SYNCING_APT"
    local apt_sync_failed=0
    if [ "$DRY_RUN" = "true" ]; then
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_APT_UPDATE")"
    elif ! run_apt_styled update; then
        printf "${YELLOW}⚠ APT index refresh failed; native package update status is unknown.\n${NC}" >&2
        apt_sync_failed=1
    fi

    local apt_upgradable=""
    local apt_count=0
    if [ "$apt_sync_failed" -eq 0 ]; then
        local apt_list_output
        if apt_list_output=$(LC_ALL=C apt list --upgradable 2>/dev/null); then
            apt_upgradable=$(printf '%s\n' "$apt_list_output" | grep -v "^Listing\\.\\.\\." || true)
            [ -n "$apt_upgradable" ] && apt_count=$(printf '%s\n' "$apt_upgradable" | grep -c '/' || true)
        else
            printf "${YELLOW}⚠ Unable to read the APT upgrade list; native package update status is unknown.\n${NC}" >&2
            apt_sync_failed=1
        fi
    fi

    echo -e ""
    printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPDATE_CHECKING_GH"
    if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
        echo -e "${GRAY}  ${MSG_NO_TRACKED_PACKAGES}${NC}"
        echo -e "${BLUE}---------------------------------------${NC}"
        [ "$apt_count" -gt 0 ] && printf "${YELLOW}ℹ %b${NC}\n" "$(printf "$MSG_UPDATE_APT_AVAIL_HINT" "$apt_count")"
        if [ "$apt_sync_failed" -eq 1 ]; then
            return 1
        fi
        return 0
    fi

    local gh_upgrades=()
    local gh_check_failed=0
    while IFS='|' read -u 3 -r pkg repo || [ -n "$pkg" ]; do
        [[ "$pkg" =~ ^#.* ]] && continue
        [ -z "$pkg" ] && continue

        local local_ver=""
        local_ver=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null | tr -d '\r')
        local_ver=$(normalize_gh_tag "$local_ver")

        local repo_path
        repo_path=$(echo "$repo" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
        local release_json
        if ! release_json=$(fetch_github_api "repos/${repo_path}/releases/latest" 15); then
            printf "${YELLOW}⚠ Unable to verify updates for %s (%s).\n${NC}" "$pkg" "$repo_path" >&2
            gh_check_failed=1
            continue
        fi
        local latest_tag
        latest_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')
        if [ -z "$latest_tag" ]; then
            printf "${YELLOW}⚠ No valid latest release was returned for %s (%s).\n${NC}" "$pkg" "$repo_path" >&2
            gh_check_failed=1
            continue
        fi
        local remote_ver
        remote_ver=$(normalize_gh_tag "$latest_tag")

        if [ -n "$remote_ver" ] && [ -n "$local_ver" ]; then
            if ! dpkg --compare-versions "$local_ver" ge "$remote_ver" 2>/dev/null; then
                gh_upgrades+=("${pkg}|${local_ver}|${remote_ver}|${repo_path}")
            fi
        fi
    done 3< "$SOURCES_FILE"

    echo -e "${BLUE}---------------------------------------${NC}"
    if [ "${#gh_upgrades[@]}" -gt 0 ]; then
        printf "${GREEN}${BOLD}%b${NC}\n" "$MSG_UPDATE_GH_AVAIL_HEADER"
        for item in "${gh_upgrades[@]}"; do
            IFS='|' read -r up_pkg up_loc up_rem up_repo <<< "$item"
            printf "${CYAN}%-20s${NC} ${YELLOW}%-12s${NC} -> ${GREEN}%-12s${NC} ${GRAY}(%s)${NC}\n" \
                "$up_pkg" "$up_loc" "$up_rem" "$up_repo"
        done
    elif [ "$gh_check_failed" -eq 1 ]; then
        printf "${YELLOW}⚠ Some tracked GitHub packages could not be checked; their update status is unknown.\n${NC}" >&2
    else
        printf "${GREEN}✔ %b${NC}\n" "$MSG_UPDATE_ALL_GH_UPTODATE"
    fi

    echo -e "${BLUE}---------------------------------------${NC}"
    if [ "$gh_check_failed" -eq 1 ] || [ "$apt_sync_failed" -eq 1 ]; then
        printf "${YELLOW}⚠ Update check incomplete: at least one package source could not be verified.\n${NC}" >&2
    elif [ "$apt_count" -gt 0 ] || [ "${#gh_upgrades[@]}" -gt 0 ]; then
        printf "${YELLOW}★ %b${NC}\n" "$(printf "$MSG_UPDATE_SUMMARY_TOTAL" "$apt_count" "${#gh_upgrades[@]}")"
        printf "${GRAY}%b${NC}\n" "$MSG_UPDATE_APPLY_HINT"
    else
        printf "${GREEN}✔ %b${NC}\n" "$MSG_UPDATE_SYSTEM_UPTODATE"
    fi
    if [ "$gh_check_failed" -eq 1 ] || [ "$apt_sync_failed" -eq 1 ]; then
        return 1
    fi

}

debup_stats() {
    echo -e "${BLUE}---------------------------------------------------------${NC}"
    echo -e "${BOLD}${CYAN}${MSG_STATS_TITLE:-Debup & System Statistics}${NC}"
    echo -e "${BLUE}---------------------------------------------------------${NC}"

    local apt_total=0
    apt_total=$(dpkg-query -f '${binary:Package}\n' -W 2>/dev/null | wc -l)
    printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_APT_TOTAL:-Native APT packages}" "${GREEN}${apt_total}${NC}"

    local gh_total=0
    local gh_pkgs=""
    if [ -f "$SOURCES_FILE" ] && [ -s "$SOURCES_FILE" ]; then
        gh_total=$(grep -vc '^[[:space:]]*#' "$SOURCES_FILE" 2>/dev/null || true)
        gh_pkgs=$(grep -v '^[[:space:]]*#' "$SOURCES_FILE" | cut -d'|' -f1 | paste -sd ", " - 2>/dev/null)
    fi
    printf " ${BOLD}%-30s${NC} : %s" "${MSG_STATS_GH_TOTAL:-Managed GitHub packages}" "${GREEN}${gh_total}${NC}"
    [ -n "$gh_pkgs" ] && printf " ${GRAY}(${gh_pkgs})${NC}"
    echo ""

    local pinned_count=0
    pinned_count=$(apt-mark showhold 2>/dev/null | wc -l)
    printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_PINNED_TOTAL:-Locked packages}" "${YELLOW}${pinned_count}${NC}"

    local cache_size="0B"
    if [ -d "$CACHE_API_DIR" ]; then
        cache_size=$(du -sh "$CACHE_API_DIR" 2>/dev/null | cut -f1)
    fi
    printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_CACHE_SIZE:-API cache size}" "${CYAN}${cache_size:-0B}${NC}"

    local rate_headers
    rate_headers=$(curl -sI --connect-timeout 10 --max-time 30 --retry 2 --retry-delay 1 \
        "${AUTH_HEADER[@]}" "https://api.github.com/rate_limit" 2>/dev/null)
    local gh_rem gh_limit gh_reset now diff_min
    gh_rem=$(echo "$rate_headers" | grep -i '^x-ratelimit-remaining:' | tr -d '\r' | awk '{print $2}')
    gh_limit=$(echo "$rate_headers" | grep -i '^x-ratelimit-limit:' | tr -d '\r' | awk '{print $2}')
    gh_reset=$(echo "$rate_headers" | grep -i '^x-ratelimit-reset:' | tr -d '\r' | awk '{print $2}')

    if [ -n "$gh_rem" ] && [ -n "$gh_limit" ]; then
        local reset_str=""
        if [ -n "$gh_reset" ]; then
            now=$(date +%s)
            diff_min=$(( (gh_reset - now) / 60 ))
            (( diff_min < 0 )) && diff_min=0
            reset_str=" ${GRAY}($(printf "${MSG_STATS_RATE_RESET:-reset in %d min}" "$diff_min"))${NC}"
        fi
        printf " ${BOLD}%-30s${NC} : %s/%s%b\n" "${MSG_STATS_RATE_LIMIT:-Remaining GitHub quota}" "${CYAN}${gh_rem}${NC}" "$gh_limit" "$reset_str"
    else
        printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_RATE_LIMIT:-Remaining GitHub quota}" "${GRAY}${MSG_STATS_RATE_OFFLINE:-Unavailable (offline)}${NC}"
    fi

    echo -e "${BLUE}---------------------------------------------------------${NC}"
}

debup_clean() {
    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "${MSG_CLEANING_CACHE:-Cleaning APT cache and temporary files...}"

    if [ "$DRY_RUN" = "true" ]; then
        printf "${YELLOW}%b${NC}\n" "${MSG_DRY_CLEAN:-Dry run: APT and API caches would be cleaned.}"
        echo -e "${BLUE}---------------------------------------${NC}"
        return 0
    fi

    local clean_failed=0
    if ! $ELEVATE apt-get clean; then
        echo -e "${YELLOW}⚠ APT clean failed.${NC}" >&2
        clean_failed=1
    fi
    if ! $ELEVATE apt-get autoclean -y; then
        echo -e "${YELLOW}⚠ APT autoclean failed.${NC}" >&2
        clean_failed=1
    fi

    if [ -d "$CACHE_API_DIR" ] &&
       ! find "$CACHE_API_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; then
        echo -e "${YELLOW}⚠ GitHub API cache cleanup failed.${NC}" >&2
        clean_failed=1
    fi

    if [ "$clean_failed" -eq 1 ]; then
        echo -e "${RED}✖ Cleanup completed with errors; review the warnings above.${NC}" >&2
        return 1
    fi

    echo -e "${GREEN}✔ ${MSG_CLEAN_SUCCESS}${NC}"
    echo -e "${BLUE}---------------------------------------${NC}"
}

debup_remove() {
    local PKG=""
    local ASSUME_YES="false"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -y|--yes) ASSUME_YES="true" ;;
            -*) echo -e "${RED}${MSG_ERR_UNKNOWN_OPTION:-Option inconnue}: $1${NC}" >&2; return 1 ;;
            *)
                if [ -n "$PKG" ]; then
                    echo -e "${RED}✖ Only one package may be specified for this command.${NC}" >&2
                    return 1
                fi
                PKG="$1"
                ;;
        esac
        shift
    done

    echo -e "${BLUE}---------------------------------------${NC}"
    [ -z "$PKG" ] && { echo -e "${YELLOW}${MSG_USAGE_REMOVE}${NC}"; return 1; }

    if [ "$DRY_RUN" = "true" ]; then
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_REMOVE_TRACK" "${CYAN}${PKG}${YELLOW}" "${SOURCES_FILE}")"
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_REMOVE_APT" "${PKG}")"
        echo -e "${BLUE}---------------------------------------${NC}"
        return 0
    fi

    if [ "$ASSUME_YES" != "true" ]; then
        local confirm=""
        prompt_read confirm "$(printf "${MSG_PROMPT_REMOVE_CONFIRM:-Purger '%s' et le retirer du suivi ? [o/N] : }" "${PKG}")\n" || confirm="n"
        if [[ ! "$confirm" =~ ^[oOyY]$ ]]; then
            echo -e "${BLUE}---------------------------------------${NC}"
            echo -e "${RED}${MSG_OP_CANCELED}${NC}"
            return 3
        fi
    fi

    printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_APT_PURGING" "${PKG}")"
    if run_apt_styled purge -y "$PKG"; then
        if [ -f "$SOURCES_FILE" ] && awk -F'|' -v package="$PKG" '$1 == package { found = 1 } END { exit !found }' "$SOURCES_FILE"; then
            local tmp_sources
            tmp_sources=$(mktemp "${TEMP_DIR}/sources.XXXXXX") || {
                echo -e "${RED}✖ Failed to create a source-list staging file.${NC}" >&2
                return 1
            }

            if ! awk -F'|' -v package="$PKG" '$1 != package' "$SOURCES_FILE" > "$tmp_sources"; then
                rm -f -- "$tmp_sources"
                echo -e "${RED}✖ Failed to filter the existing source list.${NC}" >&2
                return 1
            fi
            if ! atomic_replace_sources "$tmp_sources"; then
                rm -f -- "$tmp_sources"
                echo -e "${RED}✖ Package was purged, but its tracking entry could not be removed.${NC}" >&2
                return 1
            fi
            rm -f -- "$tmp_sources"
            printf "${GREEN}%b${NC}\n" "$(printf "$MSG_REMOVE_TRACK_SUCCESS" "${PKG}")"
        fi

        if ! $ELEVATE env DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y >/dev/null 2>&1; then
            echo -e "${YELLOW}⚠ Package was purged, but APT autoremove did not complete successfully.${NC}" >&2
        fi
        printf "${GREEN}✔ %b${NC}\n" "$(printf "$MSG_APT_PURGE_SUCCESS" "${PKG}")"
    else
        printf "${RED}✖ %b${NC}\n" "$(printf "$MSG_APT_PURGE_FAIL" "${PKG}")"
    fi
}

case "$1" in
    add|install|-a|-i)
        shift
        ASSUME_YES="false"
        TARGET=""
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -y|--yes) ASSUME_YES="true" ;;
                -*)
                    echo -e "${RED}${MSG_ERR_UNKNOWN_OPTION:-Unknown option}: $1${NC}" >&2
                    exit 1
                    ;;
                *)
                    if [ -n "$TARGET" ]; then
                        echo -e "${RED}✖ Only one package or repository may be specified for this command.${NC}" >&2
                        exit 1
                    fi
                    TARGET="$1"
                    ;;
            esac
            shift
        done

        echo -e "${BLUE}---------------------------------------${NC}"
        [ -z "$TARGET" ] && { echo -e "${YELLOW}${MSG_USAGE_ADD}${NC}"; exit 1; }

        if [[ "$TARGET" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+(@.+)?$ ]] || [[ "$TARGET" =~ github\.com ]]; then
            check_and_update "$TARGET" "" "$ASSUME_YES"
        else
            printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_APT_INSTALLING" "${BOLD}${TARGET}${NC}${CYAN}")"
            if ! install_apt_package "$TARGET" "$ASSUME_YES"; then
                echo -e "${BLUE}---------------------------------------${NC}"
                printf "${RED}✖ %b${NC}\n\n" "$(printf "${MSG_APT_INSTALL_FAIL:-APT package installation failed: %s}" "${TARGET}")"
                exit 1
            fi
            if [ "$DRY_RUN" != "true" ]; then
                echo -e "${BLUE}---------------------------------------${NC}"
                printf "${GREEN}✔ %b${NC}\n\n" "$(printf "${MSG_APT_INSTALL_SUCCESS:-APT package %s installed.}" "${TARGET}")"
            fi
        fi
        ;;

    update|-v)
        shift
        debup_check_updates
        ;;

    upgrade|-u|-U)
        shift
        ASSUME_YES="false"
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -y|--yes) ASSUME_YES="true" ;;
                *)
                    echo -e "${RED}${MSG_ERR_UNKNOWN_OPTION:-Unknown option}: $1${NC}" >&2
                    exit 1
                    ;;
            esac
            shift
        done

        echo -e "${BLUE}---------------------------------------${NC}"
        printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPGRADE_APT_TITLE"
        apt_upgrade_failed=0
        if [ "$DRY_RUN" = "true" ]; then
            printf "${YELLOW}%b${NC}\n" "$MSG_DRY_APT_UPGRADE"
        else
            apt_upgrade_plan=""
            if ! apt_upgrade_plan=$($ELEVATE env LC_ALL=C apt-get --simulate dist-upgrade 2>&1); then
                echo -e "${RED}✖ APT could not simulate the system upgrade; no APT changes were made.${NC}" >&2
                printf '%s\n' "$apt_upgrade_plan" >&2
                apt_upgrade_failed=1
            elif apt_plan_has_removals "$apt_upgrade_plan"; then
                echo -e "${RED}✖ APT system upgrade would remove or purge installed packages; refusing the transaction.${NC}" >&2
                printf '%s\n' "$apt_upgrade_plan" | awk '$1 == "Remv" || $1 == "Purg" { print }' >&2
                apt_upgrade_failed=1
            else
                apt_args=(--no-remove dist-upgrade)
                [ "$ASSUME_YES" = "true" ] && apt_args+=("-y")
                if ! run_apt_styled "${apt_args[@]}"; then
                    echo -e "${RED}✖ APT system upgrade failed.${NC}" >&2
                    apt_upgrade_failed=1
                fi
            fi
        fi

        echo -e ""
        printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPGRADE_GH_TITLE"
        echo -e "${BLUE}---------------------------------------${NC}"

        if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
            echo -e "${YELLOW}${MSG_NO_TRACKED_PACKAGES}${NC}"
            if [ "$apt_upgrade_failed" -eq 1 ]; then
                exit 1
            fi
            exit 0
        fi

        updated_count=0
        total_count=0
        failed_count=0

        while IFS='|' read -u 3 -r pkg repo || [ -n "$pkg" ]; do
            [[ "$pkg" =~ ^#.* ]] && continue
            [ -z "$pkg" ] && continue
            total_count=$((total_count + 1))

            check_and_update "$repo" "$pkg" "$ASSUME_YES"
            status=$?

            if [ "$status" -eq 0 ]; then
                updated_count=$((updated_count + 1))
            elif [ "$status" -eq 1 ]; then
                failed_count=$((failed_count + 1))
            fi
        done 3< "$SOURCES_FILE"

        echo -e "${BLUE}---------------------------------------${NC}"
        if [ "$failed_count" -gt 0 ]; then
            printf "${YELLOW}⚠ %d tracked GitHub package(s) could not be updated or verified.\n${NC}" "$failed_count" >&2
        elif [ "$updated_count" -gt 0 ]; then
            if [ "$DRY_RUN" = "true" ]; then
                printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_UPGRADE_SUMMARY" "$updated_count" "$total_count")"
            else
                printf "${GREEN}%b${NC}\n" "$(printf "$MSG_UPGRADE_SUMMARY" "$updated_count" "$total_count")"
            fi
        else
            printf "${GREEN}%b${NC}\n" "$(printf "$MSG_ALL_UP_TO_DATE" "$total_count")"
        fi
        if [ "$apt_upgrade_failed" -eq 1 ] || [ "$failed_count" -gt 0 ]; then
            exit 1
        fi
        ;;

    list|-l)
        if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
            echo -e "${BLUE}---------------------------------------${NC}"
            echo -e "${YELLOW}${MSG_NO_PKGS_REGISTERED}${NC}"
            exit 0
        fi
        printf "${YELLOW}%-25s %-35s %s${NC}\n" "$MSG_COL_PACKAGE" "$MSG_COL_REPO" "$MSG_COL_STATUS"
        printf "${GRAY}%-25s %-35s %s${NC}\n" "-------" "----------" "------"
        while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
            [[ "$pkg" =~ ^#.* ]] && continue
            [ -z "$pkg" ] && continue
            status="${GREEN}${MSG_STATUS_ACTIVE}${NC}"
            if apt-mark showhold 2>/dev/null | grep -qx "$pkg"; then
                status="${YELLOW}${MSG_STATUS_PINNED}${NC}"
            fi
            printf "${CYAN}%-25s${NC} %-35s %b\n" "$pkg" "$repo" "$status"
        done < "$SOURCES_FILE"
        ;;

    remove|-r)
        shift
        debup_remove "$@"
        ;;

    pin|-p)
        shift
        [ "$#" -ne 1 ] && { echo -e "${YELLOW}${MSG_USAGE_PIN}${NC}" >&2; exit 1; }
        PKG="$1"
        echo -e "${BLUE}---------------------------------------${NC}"
        if [ "$DRY_RUN" = "true" ]; then
            printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_PIN" "${PKG}")"
            exit 0
        fi
        if $ELEVATE apt-mark hold "$PKG"; then
            printf "${GREEN}%b${NC}\n" "$(printf "$MSG_PIN_SUCCESS" "${PKG}")"
        fi
        ;;

    unpin|-n)
        shift
        [ "$#" -ne 1 ] && { echo -e "${YELLOW}${MSG_USAGE_UNPIN}${NC}" >&2; exit 1; }
        PKG="$1"
        echo -e "${BLUE}---------------------------------------${NC}"
        if [ "$DRY_RUN" = "true" ]; then
            printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_UNPIN" "${PKG}")"
            exit 0
        fi
        if $ELEVATE apt-mark unhold "$PKG"; then
            printf "${GREEN}%b${NC}\n" "$(printf "$MSG_UNPIN_SUCCESS" "${PKG}")"
        fi
        ;;

    token|auth|ghtoken|-t)
        shift
        set_github_token "$1"
        ;;

    search|-s)
        shift
        debup_search "$*"
        ;;

    info|show|-f)
        debup_info "$2"
        ;;

    inspect|audit|-I)
        shift
        debup_inspect "$1"
        ;;

    "")
        debup_check_updates
        ;;

    stats|--stats|-S)
        debup_stats
        ;;

    clean|-c)
        debup_clean
        ;;

    -Syu|-Syyu|-syu)
        printf "I use ${RED}Debian${NC} btw.\n"
        printf "All the stability of ${RED}Debian${NC}, all the speed and comfort of ${BLUE}Arch${NC}.\n"
        debup_check_updates
        ;;

    help|-h|--help|--show-help)
        show_banner
        echo -e "${NC}"
        echo -e "${BOLD}${MSG_HELP_SEC_PKG}${NC}"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-i, install, -a, add [-y] <repo>" "$MSG_HELP_ADD"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-u, upgrade [-y]"                 "$MSG_HELP_UPGRADE"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-r, remove <pkg> [-y]"            "$MSG_HELP_REMOVE"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n\n" "-p, pin | -n, unpin <pkg>"      "$MSG_HELP_PIN"

        echo -e "${BOLD}${MSG_HELP_SEC_DISCOVERY}${NC}"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-s, search <query>"               "$MSG_HELP_SEARCH"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-f, info <repo>"                  "$MSG_HELP_INFO"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-l, list"                         "$MSG_HELP_LIST"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-S, stats"                        "$MSG_HELP_STATS"

        echo -e "${BOLD}${MSG_HELP_SEC_CONFIG}${NC}"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n\n" "-t, auth, token [PAT]"          "$MSG_HELP_AUTH"

        echo -e "${BOLD}${MSG_HELP_SEC_OPTIONS}${NC}"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-d, --dry-run"                    "$MSG_HELP_DRY"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-I, inspect, audit <repo>"        "${MSG_HELP_INSPECT:-Inspect .deb scripts and file tree before install}"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-c, clean"                        "${MSG_HELP_CLEAN:-Clean APT cache and leftover files}"
        printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-h, help"                         "$MSG_HELP_HELP"
        ;;

    *)
        cmd_name="$(basename "$0")"
        printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_UNKNOWN_CMD" "$1")"
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_RUN_HELP_HINT" "$cmd_name")"
        exit 1
        ;;
esac