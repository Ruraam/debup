SYSTEM_LOCALE="${LC_ALL:-${LANG:-en}}"
USER_LANG="${SYSTEM_LOCALE%%_*}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"

CONF_DIR="/etc/debup"
SOURCES_FILE="${CONF_DIR}/sources.list"

TEMP_DIR=$(mktemp -d "/tmp/debup.XXXXXX")
cleanup() {
  rm -rf -- "$TEMP_DIR"
}
trap cleanup EXIT INT TERM

CACHE_API_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/debup/api"
mkdir -p -m 700 "$CACHE_API_DIR" 2>/dev/null || mkdir -p "$CACHE_API_DIR"

if [ -d "/usr/local/share/debup/locales" ]; then
  LOCALE_DIR="/usr/local/share/debup/locales"
elif [ -d "/usr/share/debup/locales" ]; then
  LOCALE_DIR="/usr/share/debup/locales"
elif [ -d "${SCRIPT_DIR}/locales" ]; then
  LOCALE_DIR="${SCRIPT_DIR}/locales"
elif [ -d "${SCRIPT_DIR}/../share/debup/locales" ]; then
  LOCALE_DIR="${SCRIPT_DIR}/../share/debup/locales"
else
  LOCALE_DIR=""
fi

if [ -n "$LOCALE_DIR" ] && [ -f "${LOCALE_DIR}/en.sh" ]; then
  # shellcheck source=/dev/null
  source "${LOCALE_DIR}/en.sh"
fi

if [ -n "$LOCALE_DIR" ] && [ "$USER_LANG" != "en" ] && [ -f "${LOCALE_DIR}/${USER_LANG}.sh" ]; then
  # shellcheck source=/dev/null
  source "${LOCALE_DIR}/${USER_LANG}.sh"
fi

BOLD='\033[1m'
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
MAGENTA='\033[0;35m'
NC='\033[0m'

show_banner() {
echo -e "${BOLD}${RED}"
cat << 'EOF'
          ********           
      ******    ******       
   ***** *****      *****    
  ****      *****     ****   
 *********      ***********  
 ***    *****  *****    ***                           
 ***       ******       **                            
 ***         **                                       
 ***         **         ****                          
  ***        **   *** ****  _      _                  
   *****     **    *****   | | ___| |__  _   _ _ __   
      ****** ** *    *  / _` |/ _ \ '_ \| | | | '_ \  
          ********     | (_| |  __/ |_) | |_| | |_) | 
                        \__,_|\___|_.__/ \__,_| .__/  
                        Hybrid Package Manager|_|     
EOF
echo -e "${NC}"
}

if grep -qi "ubuntu" /etc/os-release 2>/dev/null; then
  DISTRO_PREF="ubuntu"
else
  DISTRO_PREF="debian"
fi

if [ "$(id -ru)" -eq 0 ]; then
  ELEVATE=""
elif command -v sudo >/dev/null 2>&1; then
  ELEVATE="sudo"
elif command -v doas >/dev/null 2>&1; then
  ELEVATE="doas"
else
  echo -e "${RED}${MSG_ERR_NO_ELEVATE}${NC}" >&2
  exit 1
fi

missing=0
for cmd in curl jq dpkg dpkg-deb apt-get apt-cache apt-mark; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    printf "${RED}Erreur : la commande '%s' est requise.${NC}\n" "$cmd" >&2
    missing=1
  fi
done
if [ "$missing" -eq 1 ]; then
  exit 1
fi

if [ ! -d "$CONF_DIR" ]; then
  $ELEVATE mkdir -p "$CONF_DIR" || {
    printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_CREATE_DIR" "$CONF_DIR")" >&2
    exit 1
  }
fi

if [ ! -f "$SOURCES_FILE" ]; then
  if ! touch "$SOURCES_FILE" 2>/dev/null; then
    $ELEVATE touch "$SOURCES_FILE" || {
      printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_CREATE_FILE" "$SOURCES_FILE")" >&2
      exit 1
    }
  fi
  $ELEVATE chmod 644 "$SOURCES_FILE" 2>/dev/null || chmod 644 "$SOURCES_FILE"
fi

ARCH=$(dpkg --print-architecture 2>/dev/null || echo "amd64")

ARCH_REGEX="$ARCH|all"
if [ "$ARCH" = "amd64" ]; then
  ARCH_REGEX="amd64|x86_64|x86-64|x64|all"
elif [ "$ARCH" = "arm64" ]; then
  ARCH_REGEX="arm64|aarch64|arm-64|armv8|arm64v8|all"
fi

run_apt_styled() {
  local status=0
  $ELEVATE env DEBIAN_FRONTEND=interactive LC_ALL=C.UTF-8 apt-get \
    -o Dpkg::Progress-Fancy="1" \
    -o APT::Color::Highlight="\e[32m" \
    "$@" 2>&1 | while IFS= read -r line; do
    case "$line" in
      Get:*|Hit:*|Ign:*)
        echo -e "  ${GRAY}↓ ${line}${NC}"
        ;;
      Reading*|Building*)
        echo -e "  ${CYAN}⚙ ${MSG_APT_READING:-$line}${NC}"
        ;;
      *Setting\ up*|*Processing*)
        echo -e "  ${CYAN}⚙ ${MSG_APT_CONFIGURING:-$line}${NC}"
        ;;
      *Unpacking*|*Preparing*)
        echo -e "  ${YELLOW}▣ ${MSG_APT_UNPACKING:-$line}${NC}"
        ;;
      *error*|*Error*|*E:*)
        echo -e "  ${RED}✖ ${line}${NC}"
        ;;
      *warning*|*Warning*|*W:*)
        echo -e "  ${YELLOW}⚠ ${line}${NC}"
        ;;
      Progress:*)
        echo -en "\r  ${BLUE}::${NC} ${line}\r"
        ;;
      *)
        [ -n "$line" ] && echo -e "  ${GRAY}${line}${NC}"
        ;;
    esac
  done
  status=${PIPESTATUS[0]}
  return "$status"
}

DRY_RUN=false
filtered_args=()
for arg in "$@"; do
  case "$arg" in
    -d|--dry-run)
      DRY_RUN=true
      ;;
    *)
      filtered_args+=("$arg")
      ;;
  esac
done
set -- "${filtered_args[@]}"

filter_compatible_debs() {
  local assets="$1"
  local filtered
  filtered=$(echo "$assets" | grep -iE "(${ARCH_REGEX})")

  if [ "$ARCH" = "amd64" ]; then
    filtered=$(echo "$filtered" | grep -ivE "(^|[^a-z0-9])(arm|aarch64?|armv[0-9]+)([^a-z0-9]|$)")
  elif [ "$ARCH" = "arm64" ]; then
    filtered=$(echo "$filtered" | grep -ivE "(^|[^a-z0-9])(x86|amd64|i[3-6]86)([^a-z0-9]|$)")
  fi

  echo "$filtered"
}

set_github_token() {
  local token="$1"

  if [ -z "$token" ]; then
    echo -en "${CYAN}${MSG_ENTER_PAT}${NC} "
    read -rs token </dev/tty
    echo ""
  fi

  if [ -z "$token" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${RED}${MSG_ERR_EMPTY_TOKEN}${NC}"
    return 1
  fi

  local shell_rc="$HOME/.bashrc"
  if [ -n "$ZSH_VERSION" ] || [[ "$SHELL" == *zsh* ]]; then
    shell_rc="$HOME/.zshrc"
  fi

  if [ -f "$shell_rc" ]; then
    sed -i '/export GITHUB_TOKEN=/d' "$shell_rc"
  fi

  echo "export GITHUB_TOKEN=\"$token\"" >> "$shell_rc"

  $ELEVATE mkdir -p "$CONF_DIR"
  echo "GITHUB_TOKEN=\"$token\"" | $ELEVATE tee "$CONF_DIR/debup.conf" >/dev/null
  $ELEVATE chmod 600 "$CONF_DIR/debup.conf"

  echo -e "${BLUE}---------------------------------------${NC}"
  echo -e "${GREEN}${MSG_TOKEN_SUCCESS}${NC}"
}

if [ -z "$GITHUB_TOKEN" ] && [ -f "$CONF_DIR/debup.conf" ]; then
  GITHUB_TOKEN=$(grep -E '^GITHUB_TOKEN=' "$CONF_DIR/debup.conf" | cut -d'=' -f2- | tr -d '"'\''')
fi

AUTH_HEADER=()
if [ -n "$GITHUB_TOKEN" ]; then
  AUTH_HEADER=(-H "Authorization: Bearer $GITHUB_TOKEN")
fi

fetch_github_api() {
  local endpoint="$1"
  local ttl="${2:-30}"

  endpoint="${endpoint#https://api.github.com/}"
  endpoint="${endpoint#/}"

  local cache_key
  cache_key=$(echo "$endpoint" | tr '/' '_')
  local cache_file="${CACHE_API_DIR}/${cache_key}.json"

  if [ -f "$cache_file" ] && [ -z "$(find "$cache_file" -mmin +"$ttl" 2>/dev/null)" ]; then
    cat "$cache_file"
    return 0
  fi

  local response
  response=$(curl -sS --connect-timeout 10 --max-time 25 --retry 2 --retry-delay 1 \
    "${AUTH_HEADER[@]}" \
    -H "Accept: application/vnd.github+json" \
    -H "User-Agent: debup-tool" \
    "https://api.github.com/${endpoint}" 2>/dev/null)

  if echo "$response" | grep -qiE '"message"[[:space:]]*:[[:space:]]*"(API rate limit|Not Found|Bad credentials)'; then
    if [ -f "$cache_file" ]; then
      cat "$cache_file"
      return 0
    fi
    echo "$response"
    return 1
  fi

  if [ -n "$response" ] && echo "$response" | jq -e . >/dev/null 2>&1; then
    echo "$response" > "$cache_file"
    echo "$response"
    return 0
  fi

  if [ -f "$cache_file" ]; then
    cat "$cache_file"
    return 0
  fi

  return 1
}

debup_inspect() {
  local target="$1"
  if [ -z "$target" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${RED}${MSG_USAGE_INSPECT}${NC}"
    return 1
  fi

  local repo_path
  repo_path=$(echo "$target" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
  local api_url="https://api.github.com/repos/${repo_path}/releases/latest"

  printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_INSPECT_TITLE" "$repo_path")"

  local release_json
  release_json=$(fetch_github_api "$api_url" 10)

  local candidate_urls
  candidate_urls=$(echo "$release_json" | jq -r --arg arch "$ARCH_REGEX" '.assets[] | select((.name | endswith(".deb")) and (.name | test($arch; "i"))) | .browser_download_url')

  if [ "$ARCH" = "amd64" ]; then
    candidate_urls=$(echo "$candidate_urls" | grep -ivE "arm|aarch")
  elif [ "$ARCH" = "arm64" ]; then
    candidate_urls=$(echo "$candidate_urls" | grep -ivE "x86|amd64|i386|i686")
  fi

  local deb_url=""
  if [ -n "$candidate_urls" ]; then
    deb_url=$(echo "$candidate_urls" | grep -i "$DISTRO_PREF" | head -n1)
    [ -z "$deb_url" ] && deb_url=$(echo "$candidate_urls" | head -n1)
  fi

  if [ -z "$deb_url" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_NO_COMPAT_DEB" "$ARCH")"
    return 1
  fi

  local tmp_deb="$TEMP_DIR/inspect.deb"
  local inspect_dir="$TEMP_DIR/control_data"
  mkdir -p "$inspect_dir"

  echo -e "${GRAY}${MSG_INSPECT_DOWNLOADING}${NC}"
  if ! curl -fsSL --connect-timeout 10 --max-time 300 --retry 2 --retry-delay 1 -o "$tmp_deb" "$deb_url"; then
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${RED}${MSG_ERR_INSPECT_DL}${NC}"
    return 1
  fi

  dpkg-deb -e "$tmp_deb" "$inspect_dir" 2>/dev/null

  echo -e "${BLUE}---------------------------------------------------------${NC}"
  echo -e "${YELLOW}⚙  ${MSG_INSPECT_SCRIPTS}${NC}"
  echo -e "${BLUE}---------------------------------------------------------${NC}"

  local found_scripts=false
  for script in preinst postinst prerm postrm; do
    if [ -f "$inspect_dir/$script" ]; then
      found_scripts=true
      echo -e "\n${BOLD}${CYAN}=== Script: $script ===${NC}"
      cat "$inspect_dir/$script"
      echo -e "${CYAN}===================================${NC}"
    fi
  done

  if [ "$found_scripts" = false ]; then
    echo -e "${GREEN}✔ ${MSG_INSPECT_NO_SCRIPTS}${NC}"
  fi

  echo -e "\n${BLUE}---------------------------------------------------------${NC}"
  echo -e "${YELLOW}${MSG_INSPECT_FILES}${NC}"
  echo -e "${BLUE}---------------------------------------------------------${NC}"

  dpkg-deb -c "$tmp_deb" | awk '{print $1, $2, $6}' | sed 's/^/  /'
  echo -e "${BLUE}---------------------------------------------------------${NC}"
}

check_and_update() {
  local REPO_URL="$1"
  local PKG_NAME="$2"
  local ASSUME_YES="$3"

  if [ -n "$PKG_NAME" ] && apt-mark showhold 2>/dev/null | grep -qx "$PKG_NAME"; then
    printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_PINNED_SKIPPED" "${CYAN}${PKG_NAME}${NC}")"
    return 2
  fi

  local api_url
  local tag=""

  if [[ "$REPO_URL" == *"@"* ]]; then
    tag="${REPO_URL##*@}"
    REPO_URL="${REPO_URL%@*}"
  fi

  if [[ "$REPO_URL" == *"api.github.com"* ]]; then
    if [ -n "$tag" ]; then
      api_url="${REPO_URL%/}/releases/tags/${tag}"
    else
      api_url="${REPO_URL%/}/releases/latest"
    fi
  else
    local repo_path
    repo_path=$(echo "$REPO_URL" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
    if [ -n "$tag" ]; then
      api_url="https://api.github.com/repos/${repo_path}/releases/tags/${tag}"
    else
      api_url="https://api.github.com/repos/${repo_path}/releases/latest"
    fi
  fi

  local release_json
  release_json=$(fetch_github_api "$api_url" 30)

  local latest_tag
  latest_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')

  if [ -z "$latest_tag" ]; then
    local error_message
    error_message=$(echo "$release_json" | jq -r '.message // empty' 2>/dev/null)

    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${RED}%b${NC} ${CYAN}%s${NC}\n" "$(printf "$MSG_ERR_FETCH_RELEASE" "")" "${repo_path:-$REPO_URL}"

    if [ -n "$error_message" ]; then
      echo -e "${BLUE}---------------------------------------${NC}"
      printf "${RED}%b${NC}${CYAN}%s${NC}\n" "$(printf "$MSG_ERR_GH_API" "")" "${error_message}"
    fi
    return 1
  fi

  local remote_ver="${latest_tag#v}"

  local local_ver=""
  if [ -n "$PKG_NAME" ]; then
    local_ver=$(dpkg-query -W -f='${Version}' "$PKG_NAME" 2>/dev/null | tr -d '\r')
  fi
  local_ver="${local_ver#v}"

  echo -e "${YELLOW}${MSG_PACKAGE_HEADER}${NC}"
  echo -e "${PKG_NAME:-$MSG_NEW_PACKAGE} ${CYAN}${local_ver:-$MSG_NOT_INSTALLED}${NC} ${GRAY}(${repo_path:-$REPO_URL})${NC}"
  printf "${GREEN}%b${NC}\n" "$(printf "$MSG_LATEST_VERSION" "$remote_ver")"

  if [ -n "$local_ver" ] && [ -n "$remote_ver" ] && dpkg --compare-versions "$local_ver" ge "$remote_ver" 2>/dev/null; then
    echo -e "${GREEN}${MSG_ALREADY_UP_TO_DATE}${NC}"
    echo -e "${BLUE}---------------------------------------${NC}"
    return 2
  fi

  local candidate_urls
  candidate_urls=$(echo "$release_json" | jq -r --arg arch "$ARCH_REGEX" '.assets[] | select((.name | endswith(".deb")) and (.name | test($arch; "i"))) | .browser_download_url')

  if [ "$ARCH" = "amd64" ]; then
    candidate_urls=$(echo "$candidate_urls" | grep -ivE "arm|aarch")
  elif [ "$ARCH" = "arm64" ]; then
    candidate_urls=$(echo "$candidate_urls" | grep -ivE "x86|amd64|i386|i686")
  fi

  local deb_url=""
  if [ -n "$candidate_urls" ]; then
    deb_url=$(echo "$candidate_urls" | grep -i "$DISTRO_PREF" | head -n1)
    if [ -z "$deb_url" ]; then
      deb_url=$(echo "$candidate_urls" | head -n1)
    fi
  fi

  if [ -z "$deb_url" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_NO_COMPAT_DEB" "$ARCH")"
    return 1
  fi

  local checksum_url
  checksum_url=$(echo "$release_json" | jq -r '.assets[] | select(.name | test("(?i)(sha256.*sums?|checksums?.*txt|.*\\.sha256$)")) | .browser_download_url' 2>/dev/null | head -n1)

  if [ "$DRY_RUN" = "true" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${YELLOW}%b${NC} ${GRAY}%s${NC}\n" "$(printf "$MSG_DRY_WOULD_DOWNLOAD" "")" "${deb_url}"
    printf "${YELLOW}%b${NC} ${CYAN}%s${NC} ${GREEN}(%s)${NC}\n" "$(printf "$MSG_DRY_WOULD_INSTALL" "" "")" "${PKG_NAME:-$deb_url}" "${latest_tag}"
    echo -e "${BLUE}---------------------------------------${NC}"
    return 0
  fi

  if [ "$ASSUME_YES" != "true" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${CYAN}${MSG_PROMPT_CONFIRM_INSTALL}${NC}"
    read -r confirm </dev/tty
    if [[ ! "$confirm" =~ ^[oOyYsSjJ]$ ]]; then
      echo -e "${BLUE}---------------------------------------${NC}"
      echo -e "${RED}${MSG_OP_CANCELED}${NC}"
      return 0
    fi
  fi

  local deb_filename
  deb_filename=$(basename "$deb_url")
  local tmp_deb="$TEMP_DIR/$deb_filename"

  echo -e "${BLUE}---------------------------------------${NC}"
  printf "${YELLOW}%b${NC}${GRAY}%s${NC}\n" "$(printf "$MSG_DOWNLOADING" "")" "${deb_url}"
  if ! curl -fsSL --connect-timeout 10 --max-time 300 --retry 2 --retry-delay 1 --progress-bar -o "$tmp_deb" "$deb_url"; then
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${RED}${MSG_ERR_DOWNLOAD_FAILED}${NC}\n"
    rm -f "$tmp_deb"
    return 1
  fi

  if [ -n "$checksum_url" ] && [ "$checksum_url" != "null" ]; then
    echo -e "${BLUE}::${NC} ${CYAN}${MSG_VERIFYING_CHECKSUM}${NC}"
    local tmp_hash_file="$TEMP_DIR/checksums.txt"
    if curl -fsSL --connect-timeout 10 --max-time 30 --retry 2 --retry-delay 1 -o "$tmp_hash_file" "$checksum_url"; then
      local real_hash
      real_hash=$(sha256sum "$tmp_deb" | awk '{print $1}')

      local expected_hash
      expected_hash=$(grep -F "$deb_filename" "$tmp_hash_file" 2>/dev/null | awk '{print $1}')

      if [ -z "$expected_hash" ] && [ "$(wc -w < "$tmp_hash_file" 2>/dev/null)" -eq 1 ]; then
        expected_hash=$(tr -d '[:space:]' < "$tmp_hash_file")
      fi

      if [ -n "$expected_hash" ]; then
        if [ "$real_hash" = "$expected_hash" ]; then
          echo -e "${GREEN}✔ ${MSG_CHECKSUM_SUCCESS}${NC}"
        else
          echo -e "${BLUE}---------------------------------------${NC}"
          echo -e "${RED}✖ ${MSG_ERR_CHECKSUM_FAILED}${NC}"
          echo -e "${GRAY}Expected: ${expected_hash}${NC}"
          echo -e "${GRAY}Got:      ${real_hash}${NC}"
          rm -f "$tmp_deb"
          return 1
        fi
      fi
    fi
  else
    echo -e "${GRAY}ℹ ${MSG_NO_CHECKSUM_FOUND}${NC}"
  fi

  if [ "$ASSUME_YES" != "true" ]; then
    local check_scripts=()
    for s in preinst postinst prerm postrm; do
      if dpkg-deb -e "$tmp_deb" "$TEMP_DIR/inspect_tmp" 2>/dev/null && [ -f "$TEMP_DIR/inspect_tmp/$s" ]; then
        check_scripts+=("$s")
      fi
    done
    rm -rf "$TEMP_DIR/inspect_tmp" 2>/dev/null

    if [ "${#check_scripts[@]}" -gt 0 ]; then
      printf "${YELLOW}%b${NC}\n" "$(printf "${MSG_PROMPT_ROOT_SCRIPTS_WARN:-⚠ Root scripts detected: %s}" "${check_scripts[*]}")"
      echo -en "${CYAN}${MSG_PROMPT_INSPECT_SCRIPTS:-Inspect them before install? [y/N]: }${NC}"
      read -r view_scripts </dev/tty
      if [[ "$view_scripts" =~ ^[oOyY]$ ]]; then
        debup_inspect "$REPO_URL"
        echo -en "${CYAN}${MSG_PROMPT_CONFIRM_AFTER_INSPECT:-Confirm install? [y/N]: }${NC}"
        read -r confirm_post_inspect </dev/tty
        if [[ ! "$confirm_post_inspect" =~ ^[oOyY]$ ]]; then
          echo -e "${BLUE}---------------------------------------${NC}"
          echo -e "${RED}${MSG_OP_CANCELED}${NC}"
          rm -f "$tmp_deb"
          return 0
        fi
      fi
    fi
  fi

  if [ -z "$PKG_NAME" ]; then
    PKG_NAME=$(dpkg-deb -f "$tmp_deb" Package 2>/dev/null || true)
  fi

  echo -e "${YELLOW}${MSG_INSTALLING_PKG}${NC}"
  local apt_log="$TEMP_DIR/apt_install.log"

  if ! $ELEVATE apt-get install -y "$tmp_deb" 2>&1| tee "$apt_log"; then
    local missing_dep

  missing_dep=$(grep -oP 'Depends:\s*\K[a-zA-Z0-9._-]+(?=\s+but it is not installable)' "$apt_log" | head -n1)

  if [ -n "$missing_dep" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${YELLOW}%b${NC}\n" "$(printf "${MSG_MISSING_DEP_DETECTED:-:: Missing dependency detected: %s}" "${missing_dep}")"

  local sibling_url
  sibling_url=$(echo "$release_json" | jq -r --arg dep"$missing_dep" '.assets[] | select((.name | endswith(".deb")) and (.name | test($dep; "i"))) | .browser_download_url' 2>/dev/null |head -n1)

  if [ -n "$sibling_url" ] &&[ "$sibling_url" != "null" ]; then
    local sibling_deb_name
    sibling_deb_name=$(basename "$sibling_url")
    local tmp_sibling="$TEMP_DIR/$sibling_deb_name"

  if [[ "$sibling_deb_name" =~ keyring|gpg|key ]]; then
    echo -e "${YELLOW}${MSG_WARN_GPG_KEY:-⚠ This package installs a GPG repository key on your system.}${NC}"
  fi

  printf "${CYAN}%b${NC}" "$(printf "${MSG_PROMPT_INSTALL_SIBLING:-Found '%s' in release. Download and install it as well? [y/N]: }" "${sibling_deb_name}")"
  read -r install_sibling </dev/tty

  if [[ "$install_sibling" =~ ^[oOyYsSjJ]$ ]]; then
    printf "${YELLOW}%b${NC}${GRAY}%s${NC}\n""$(printf "$MSG_DOWNLOADING" "")" "${sibling_url}"
    if curl -fsSL --connect-timeout 10 --max-time 300 --retry 2 --retry-delay 1 --progress-bar -o "$tmp_sibling" "$sibling_url"; then
      echo -e "${YELLOW}${MSG_RETRY_WITH_DEPS:-Retrying installation with resolved dependencies...}${NC}"
    if $ELEVATE apt-get install-y "$tmp_sibling" "$tmp_deb"; then
       rm -f "$tmp_deb" "$tmp_sibling" "$apt_log"
      echo -e "${BLUE}---------------------------------------${NC}"
      printf "${GREEN}%b${NC}\n\n" "$(printf "$MSG_SUCCESS_INSTALLED" "${PKG_NAME}" "${latest_tag}")"

  if [ -n "$PKG_NAME" ] && ! grep -q "^${PKG_NAME}|" "$SOURCES_FILE" 2>/dev/null; then
    local tmp_sources
    tmp_sources=$(mktemp)
    cat "$SOURCES_FILE" > "$tmp_sources" 2>/dev/null || true
    echo "${PKG_NAME}|${REPO_URL}" >> "$tmp_sources"
    $ELEVATE cp "$tmp_sources" "$SOURCES_FILE"
    rm -f "$tmp_sources"
  fi
  return 0
  fi
  rm -f "$tmp_sibling"
  fi
  fi
  fi
  fi

  rm -f "$tmp_deb" "$apt_log"
  echo -e "${BLUE}---------------------------------------${NC}"
  echo -e "${RED}${MSG_ERR_INSTALL_FAILED}${NC}\n"
  return 1
  fi

  rm -f "$tmp_deb" "$apt_log"
  echo -e "${BLUE}---------------------------------------${NC}"
  printf "${GREEN}%b${NC}\n\n" "$(printf "$MSG_SUCCESS_INSTALLED" "${PKG_NAME}" "${latest_tag}")"

  if [ -n "$PKG_NAME" ] && ! grep -q "^${PKG_NAME}|" "$SOURCES_FILE" 2>/dev/null; then
    local tmp_sources
    tmp_sources=$(mktemp)
    cat "$SOURCES_FILE" > "$tmp_sources" 2>/dev/null || true
    echo "${PKG_NAME}|${REPO_URL}" >> "$tmp_sources"
    $ELEVATE cp "$tmp_sources" "$SOURCES_FILE"
    rm -f "$tmp_sources"
  fi
  return 0
}

debup_search() {
  local query="$*"
  if [ -z "$query" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${RED}${MSG_USAGE_SEARCH}${NC}"
    return 1
  fi

  local gh_query
  gh_query=$(echo "$query" | tr ' ' '+')

  echo -e "${BLUE}---------------------------------------${NC}"
  printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_SEARCHING_GH" "$query")"

  local global_targets=()
  local global_types=()
  local display_idx=1

  echo -e "\n${MAGENTA}${BOLD}[ Debian / APT ]${NC}"
  echo -e "${BLUE}---------------------------------------------------------${NC}"
  local apt_results
  apt_results=$(apt-cache search "$query" 2>/dev/null | head -n 5)

  if [ -n "$apt_results" ]; then
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      local apt_pkg apt_desc
      apt_pkg=$(echo "$line" | awk '{print $1}')
      apt_desc=$(echo "$line" | cut -d' ' -f2-)

      global_targets[display_idx]="$apt_pkg"
      global_types[display_idx]="APT"

      printf " ${YELLOW}[%d]${NC} ${BOLD}%-35s${NC} ${GRAY}(APT)${NC}\n     ${GRAY}%s${NC}\n" \
        "$display_idx" "$apt_pkg" "${apt_desc:0:70}"
      ((display_idx++))
    done <<< "$apt_results"
  else
    echo -e " ${GRAY}${MSG_SEARCH_NO_APT}${NC}"
  fi

  echo -e "\n${GREEN}${BOLD}[ GitHub Releases ]${NC}"
  echo -e "${BLUE}---------------------------------------------------------${NC}"

  local raw_results
  raw_results=$(curl -sS --connect-timeout 10 --max-time 30 --retry 2 --retry-delay 1 \
    "${AUTH_HEADER[@]}" \
    "https://api.github.com/search/repositories?q=${gh_query}+in:name&sort=stars&order=desc&per_page=10")

  local raw_count
  raw_count=$(echo "$raw_results" | jq -r '.items | length' 2>/dev/null)

  if [ -n "$raw_count" ] && [ "$raw_count" -gt 0 ]; then
    echo -e "${GRAY}${MSG_VERIFYING_DEBS}${NC}"

    local repos=()
    local stars_list=()
    local desc_list=()
    local gh_valid=0

    while IFS=$'\t' read -r repo stars desc; do
      local check_release
      check_release=$(curl -sS --connect-timeout 10 --max-time 30 --retry 2 --retry-delay 1 \
        "${AUTH_HEADER[@]}" \
        "https://api.github.com/repos/${repo}/releases/latest")

      local has_deb
      has_deb=$(echo "$check_release" | jq -r '.assets[]?.name' 2>/dev/null | grep -i '\.deb$' | head -n1)

      if [ -n "$has_deb" ]; then
        repos+=("$repo")
        stars_list+=("$stars")
        desc_list+=("${desc:-$MSG_NO_DESC}")

        global_targets[display_idx]="$repo"
        global_types[display_idx]="GH"

        printf " ${YELLOW}[%d]${NC} ${BOLD}%-35s${NC} ${YELLOW}★ %-6s${NC}\n     ${GRAY}%s${NC}\n" \
          "$display_idx" "$repo" "$stars" "${desc:0:70}"

        ((display_idx++))
        ((gh_valid++))
        [ "$gh_valid" -ge 5 ] && break
      fi
    done < <(echo "$raw_results" | jq -r '.items[] | [.full_name, (.stargazers_count|tostring), (.description // "")] | @tsv')

    if [ "$gh_valid" -eq 0 ]; then
      printf " ${GRAY}%b${NC}\n" "$(printf "$MSG_NO_DEB_IN_REPOS" "$query")"
    fi
  else
    printf " ${GRAY}%b${NC}\n" "$(printf "$MSG_NO_REPOS_FOUND" "$query")"
  fi

  local total_options=$((display_idx - 1))
  echo -e "${BLUE}---------------------------------------------------------${NC}"

  if [ "$total_options" -eq 0 ]; then
    echo -e "${YELLOW}${MSG_SEARCH_NO_RESULTS}${NC}"
    return 0
  fi

  echo -en "${CYAN}${MSG_PROMPT_SELECT_NUM:-Enter n° of packages to install (e.g., 1 2 3 or 1-3) [default: cancel]: }${NC}"
  local raw_input
  read -r raw_input </dev/tty
  [ -z "$raw_input" ] && { echo -e "${CYAN}${MSG_OP_CANCELED}${NC}"; return 0; }

  local -a packagesnum=(${raw_input//,/ })

  local -a selected_indices=()

  for token in "${packagesnum[@]}"; do
    if [[ "$token" =~ ^([0-9]+)-([0-9]+)$ ]]; then
      local start="${BASH_REMATCH[1]}"
      local end="${BASH_REMATCH[2]}"
      if (( start > 0 && end <= total_options && start <= end )); then
        for ((idx=start; idx<=end; idx++)); do
          selected_indices+=("$idx")
        done
      fi
    elif [[ "$token" =~ ^[0-9]+$ ]]; then
      if (( token >= 1 && token <= total_options )); then
        selected_indices+=("$token")
      fi
    fi
  done

  [ "${#selected_indices[@]}" -eq 0 ] && { echo -e "${RED}${MSG_OP_CANCELED}${NC}"; return 0; }

  local -a unique_indices=($(printf "%s\n" "${selected_indices[@]}" | sort -nu))

  for choice in "${unique_indices[@]}"; do
    local selected_target="${global_targets[choice]}"
    local selected_type="${global_types[choice]}"

    echo -e "${BLUE}---------------------------------------${NC}"

    if [ "$selected_type" = "APT" ]; then
      printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_APT_INSTALLING" "${BOLD}${selected_target}${NC}${CYAN}")"
      run_apt_styled install -y "$selected_target"
    else
      local selected_repo="$selected_target"
      printf "${CYAN}%b${NC} ${GREEN}%s${NC}...\n" "$(printf "$MSG_INSPECTING_ASSETS" "")" "$selected_repo"

      local release_data
      release_data=$(fetch_github_api "repos/${selected_repo}/releases/latest" 10)

      local deb_assets
      deb_assets=$(echo "$release_data" | jq -r '.assets[]?.name' 2>/dev/null | grep -i '\.deb$')

      if [ -z "$deb_assets" ]; then
        echo -e "${RED}${MSG_ERR_NO_DEB_IN_RELEASE}${NC}"
        continue
      fi

      local matching_deb
      matching_deb=$(filter_compatible_debs "$deb_assets")

      if [ -z "$matching_deb" ]; then
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_WARN_NO_ARCH_MATCH" "$ARCH")"
        read -rp "$MSG_PROMPT_FORCE_INSTALL " force_install </dev/tty
        if [[ ! "$force_install" =~ ^[oOyYsSjJ]$ ]]; then
          echo -e "${CYAN}${MSG_INSTALL_CANCELED}${NC}"
          continue
        fi
      fi

      echo -e "${GREEN}${MSG_COMPAT_PKG_DETECTED}${NC}"
      check_and_update "$selected_repo" "" false
    fi
  done
}

debup_info() {
  local target="$1"
  if [ -z "$target" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e "${RED}${MSG_USAGE_INFO}${NC}"
    return 1
  fi

  target=$(echo "$target" | sed -e 's|https://github.com/||g' -e 's|/$||')

  echo -e "${BLUE}---------------------------------------${NC}"
  printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_FETCHING_METADATA" "${GREEN}${target}${CYAN}")"

  local repo_data
  repo_data=$(curl -sS --connect-timeout 10 --max-time 30 --retry 2 --retry-delay 1 \
    "${AUTH_HEADER[@]}" "https://api.github.com/repos/${target}")

  local not_found
  not_found=$(echo "$repo_data" | jq -r '.message' 2>/dev/null)
  if [ "$not_found" = "Not Found" ]; then
    printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_REPO_NOT_FOUND" "$target")"
    return 1
  fi

  local release_data
  release_data=$(curl -sS --connect-timeout 10 --max-time 30 --retry 2 --retry-delay 1 \
    "${AUTH_HEADER[@]}" "https://api.github.com/repos/${target}/releases/latest")

  local tag_name
  tag_name=$(echo "$release_data" | jq -r '.tag_name // empty' 2>/dev/null)
  if [ -z "$tag_name" ]; then
    echo -e "${YELLOW}${MSG_WARN_NO_RELEASES}${NC}"
    return 1
  fi

  local description stars license published_at deb_assets
  description=$(echo "$repo_data" | jq -r --arg def "$MSG_INFO_NO_DESC" '.description // $def')
  stars=$(echo "$repo_data" | jq -r '.stargazers_count')
  license=$(echo "$repo_data" | jq -r --arg def "$MSG_INFO_NONE" '.license.spdx_id // $def')
  published_at=$(echo "$release_data" | jq -r '.published_at' | cut -d'T' -f1)
  deb_assets=$(echo "$release_data" | jq -r '.assets[]?.name' 2>/dev/null | grep -i '\.deb$')

  local matching_deb
  matching_deb=$(filter_compatible_debs "$deb_assets")

  echo -e "${BLUE}---------------------------------------${NC}"
  printf " ${BOLD}${CYAN}%-14s${NC} %s\n" "$MSG_INFO_PKG" "$target"
  printf " ${BOLD}${CYAN}%-14s${NC} ${GREEN}%s${NC} (%s)\n" "$MSG_INFO_LATEST" "$tag_name" "$published_at"
  printf " ${BOLD}${CYAN}%-14s${NC} ${YELLOW}★ %s${NC}\n" "$MSG_INFO_STARS" "$stars"
  printf " ${BOLD}${CYAN}%-14s${NC} %s\n" "$MSG_INFO_LICENSE" "$license"
  printf " ${BOLD}${CYAN}%-14s${NC} %s\n" "$MSG_INFO_DESC" "$description"
  echo -e "${BLUE}---------------------------------------${NC}"

  if [ -n "$matching_deb" ]; then
    printf " ${BOLD}${CYAN}%b${NC}\n" "$(printf "$MSG_INFO_COMPAT_DEBS" "$ARCH")"
    echo "$matching_deb" | sed 's/^/   • /'
  elif [ -n "$deb_assets" ]; then
    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_WARN_NO_ARCH_DEBS" "$ARCH")"
    echo "$deb_assets" | sed 's/^/   • /'
  else
    echo -e "${BLUE}---------------------------------------${NC}"
    echo -e " ${RED}${MSG_ERR_NO_DEB_IN_REL}${NC}"
  fi
}

debup_check_updates() {
  echo -e "${BLUE}---------------------------------------${NC}"
  printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPDATE_SYNCING_APT"
  if [ "$DRY_RUN" = "true" ]; then
    printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_APT_UPDATE")"
  else
    run_apt_styled update
  fi

  local apt_upgradable
  apt_upgradable=$(LC_ALL=C apt list --upgradable 2>/dev/null | grep -v "^Listing\.\.\.")
  local apt_count=0
  [ -n "$apt_upgradable" ] && apt_count=$(echo "$apt_upgradable" | grep -c '/' || true)

  echo -e ""
  printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPDATE_CHECKING_GH"
  if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
    echo -e "${GRAY}  ${MSG_NO_TRACKED_PACKAGES}${NC}"
    echo -e "${BLUE}---------------------------------------${NC}"
    [ "$apt_count" -gt 0 ] && printf "${YELLOW}ℹ %b${NC}\n" "$(printf "$MSG_UPDATE_APT_AVAIL_HINT" "$apt_count")"
    return 0
  fi

  local gh_upgrades=()
  while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
    [[ "$pkg" =~ ^#.* ]] && continue
    [ -z "$pkg" ] && continue

    local local_ver=""
    local_ver=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null | tr -d '\r')
    local_ver="${local_ver#v}"

    local repo_path
    repo_path=$(echo "$repo" | sed -E 's#^https?://github.com/##; s#/$##; s#\.git$##')
    local release_json
    release_json=$(fetch_github_api "repos/${repo_path}/releases/latest" 15)
    local latest_tag
    latest_tag=$(echo "$release_json" | jq -r '.tag_name // empty' 2>/dev/null | tr -d '\r')
    local remote_ver="${latest_tag#v}"

    if [ -n "$remote_ver" ] && [ -n "$local_ver" ]; then
      if ! dpkg --compare-versions "$local_ver" ge "$remote_ver" 2>/dev/null; then
        gh_upgrades+=("${pkg}|${local_ver}|${remote_ver}|${repo_path}")
      fi
    fi
  done < "$SOURCES_FILE"

  echo -e "${BLUE}---------------------------------------${NC}"
  if [ "${#gh_upgrades[@]}" -gt 0 ]; then
    printf "${GREEN}${BOLD}%b${NC}\n" "$MSG_UPDATE_GH_AVAIL_HEADER"
    for item in "${gh_upgrades[@]}"; do
      IFS='|' read -r up_pkg up_loc up_rem up_repo <<< "$item"
      printf "${CYAN}%-20s${NC} ${YELLOW}%-12s${NC} -> ${GREEN}%-12s${NC} ${GRAY}(%s)${NC}\n" \
        "$up_pkg" "$up_loc" "$up_rem" "$up_repo"
    done
  else
    printf "${GREEN}✔ %b${NC}\n" "$MSG_UPDATE_ALL_GH_UPTODATE"
  fi

  echo -e "${BLUE}---------------------------------------${NC}"
  if [ "$apt_count" -gt 0 ] || [ "${#gh_upgrades[@]}" -gt 0 ]; then
    printf "${YELLOW}★ %b${NC}\n" "$(printf "$MSG_UPDATE_SUMMARY_TOTAL" "$apt_count" "${#gh_upgrades[@]}")"
    printf "${GRAY}%b${NC}\n" "$MSG_UPDATE_APPLY_HINT"
  else
    printf "${GREEN}✔ %b${NC}\n" "$MSG_UPDATE_SYSTEM_UPTODATE"
  fi
}

debup_stats() {
  echo -e "${BLUE}---------------------------------------------------------${NC}"
  echo -e "${BOLD}${CYAN}${MSG_STATS_TITLE:-Debup & System Statistics}${NC}"
  echo -e "${BLUE}---------------------------------------------------------${NC}"

  local apt_total=0
  apt_total=$(dpkg-query -f '${binary:Package}\n' -W 2>/dev/null | wc -l)
  printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_APT_TOTAL:-Native APT packages}" "${apt_total}"

  local gh_total=0
  local gh_pkgs=""
  if [ -f "$SOURCES_FILE" ] && [ -s "$SOURCES_FILE" ]; then
    gh_total=$(grep -vc '^[[:space:]]*#' "$SOURCES_FILE" 2>/dev/null || true)
    gh_pkgs=$(grep -v '^[[:space:]]*#' "$SOURCES_FILE" | cut -d'|' -f1 | paste -sd ", " - 2>/dev/null)
  fi
  printf " ${BOLD}%-30s${NC} : %s" "${MSG_STATS_GH_TOTAL:-Managed GitHub packages}" "${gh_total}"
  [ -n "$gh_pkgs" ] && printf " ${GRAY}(${gh_pkgs})${NC}"
  echo ""

  local pinned_count=0
  pinned_count=$(apt-mark showhold 2>/dev/null | wc -l)
  printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_PINNED_TOTAL:-Locked packages}" "${pinned_count}"

  local cache_size="0B"
  if [ -d "$CACHE_API_DIR" ]; then
    cache_size=$(du -sh "$CACHE_API_DIR" 2>/dev/null | cut -f1)
  fi
  printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_CACHE_SIZE:-API cache size}" "${cache_size:-0B}"

  local rate_headers
  rate_headers=$(curl -sI --connect-timeout 10 --max-time 30 --retry 2 --retry-delay 1 \
    "${AUTH_HEADER[@]}" "https://api.github.com/rate_limit" 2>/dev/null)
  local gh_rem gh_limit gh_reset now diff_min
  gh_rem=$(echo "$rate_headers" | grep -i '^x-ratelimit-remaining:' | tr -d '\r' | awk '{print $2}')
  gh_limit=$(echo "$rate_headers" | grep -i '^x-ratelimit-limit:' | tr -d '\r' | awk '{print $2}')
  gh_reset=$(echo "$rate_headers" | grep -i '^x-ratelimit-reset:' | tr -d '\r' | awk '{print $2}')

  if [ -n "$gh_rem" ] && [ -n "$gh_limit" ]; then
    local reset_str=""
    if [ -n "$gh_reset" ]; then
      now=$(date +%s)
      diff_min=$(( (gh_reset - now) / 60 ))
      (( diff_min < 0 )) && diff_min=0
      reset_str=" ${GRAY}($(printf "${MSG_STATS_RATE_RESET:-reset in %d min}" "$diff_min"))${NC}"
    fi
    printf " ${BOLD}%-30s${NC} : %s/%s%b\n" "${MSG_STATS_RATE_LIMIT:-Remaining GitHub quota}" "${gh_rem}" "$gh_limit" "$reset_str"
  else
    printf " ${BOLD}%-30s${NC} : %s\n" "${MSG_STATS_RATE_LIMIT:-Remaining GitHub quota}" "${MSG_STATS_RATE_OFFLINE:-Unavailable (offline)}"
  fi

  echo -e "${BLUE}---------------------------------------------------------${NC}"
}

debup_clean() {
  echo -e "${BLUE}---------------------------------------${NC}"
  printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "${MSG_CLEANING_CACHE:-Cleaning APT cache and temporary files...}"

  $ELEVATE apt-get clean
  $ELEVATE apt-get autoclean -y >/dev/null 2>&1

  rm -rf /tmp/debup.* >/dev/null 2>&1

  rm -rf "${CACHE_API_DIR:?}"/* >/dev/null 2>&1

  echo -e "${GREEN}✔ ${MSG_CLEAN_SUCCESS}${NC}"
  echo -e "${BLUE}---------------------------------------${NC}"
}

case "$1" in
  add|install|-a|-i)
    shift
    ASSUME_YES="false"
    TARGET=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -y|--yes) ASSUME_YES="true" ;;
        *) TARGET="$1" ;;
      esac
      shift
    done

    echo -e "${BLUE}---------------------------------------${NC}"
    [ -z "$TARGET" ] && { echo -e "${YELLOW}${MSG_USAGE_ADD}${NC}"; exit 1; }

    if [[ "$TARGET" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+(@.+)?$ ]] || [[ "$TARGET" =~ github\.com ]]; then
      check_and_update "$TARGET" "" "$ASSUME_YES"
    else
      printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_APT_INSTALLING" "${BOLD}${TARGET}${NC}${CYAN}")"
      if [ "$DRY_RUN" = "true" ]; then
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_APT_INSTALL" "$TARGET")"
      else
        apt_args=("install")
        [ "$ASSUME_YES" = "true" ] && apt_args+=("-y")
        apt_args+=("$TARGET")

        if run_apt_styled "${apt_args[@]}"; then
          echo -e "${BLUE}---------------------------------------${NC}"
          printf "${GREEN}✔ %b${NC}\n\n" "$(printf "$MSG_APT_INSTALL_SUCCESS" "${TARGET}")"
        else
          echo -e "${BLUE}---------------------------------------${NC}"
          printf "${RED}✖ %b${NC}\n\n" "$(printf "$MSG_APT_INSTALL_FAIL" "${TARGET}")"
        fi
      fi
    fi
    ;;

  update|-v)
    shift
    debup_check_updates
    ;;

  upgrade|-u|-U)
    shift
    ASSUME_YES="false"
    while [ "$#" -gt 0 ]; do
      case "$1" in
        -y|--yes) ASSUME_YES="true" ;;
      esac
      shift
    done

    echo -e "${BLUE}---------------------------------------${NC}"
    printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPGRADE_APT_TITLE"
    if [ "$DRY_RUN" = "true" ]; then
      printf "${YELLOW}%b${NC}\n" "$MSG_DRY_APT_UPGRADE"
    else
      apt_args=("dist-upgrade")
      [ "$ASSUME_YES" = "true" ] && apt_args+=("-y")
      run_apt_styled "${apt_args[@]}"
    fi

    echo -e ""
    printf "${BLUE}::${NC} ${BOLD}%b${NC}\n" "$MSG_UPGRADE_GH_TITLE"
    echo -e "${BLUE}---------------------------------------${NC}"

    if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
      echo -e "${YELLOW}${MSG_NO_TRACKED_PACKAGES}${NC}"
      exit 0
    fi

    updated_count=0
    total_count=0

    while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
      [[ "$pkg" =~ ^#.* ]] && continue
      [ -z "$pkg" ] && continue
      ((total_count++))

      check_and_update "$repo" "$pkg" "$ASSUME_YES"
      status=$?

      if [ "$status" -eq 0 ]; then
        ((updated_count++))
      fi
    done < "$SOURCES_FILE"

    echo -e "${BLUE}---------------------------------------${NC}"
    if [ "$updated_count" -gt 0 ]; then
      if [ "$DRY_RUN" = "true" ]; then
        printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_UPGRADE_SUMMARY" "$updated_count" "$total_count")"
      else
        printf "${GREEN}%b${NC}\n" "$(printf "$MSG_UPGRADE_SUMMARY" "$updated_count" "$total_count")"
      fi
    else
      printf "${GREEN}%b${NC}\n" "$(printf "$MSG_ALL_UP_TO_DATE" "$total_count")"
    fi
    echo -e "${BLUE}---------------------------------------${NC}"
    ;;

  list|-l)
    if [ ! -f "$SOURCES_FILE" ] || [ ! -s "$SOURCES_FILE" ]; then
      echo -e "${BLUE}---------------------------------------${NC}"
      echo -e "${YELLOW}${MSG_NO_PKGS_REGISTERED}${NC}"
      exit 0
    fi
    printf "${YELLOW}%-25s %-35s %s${NC}\n" "$MSG_COL_PACKAGE" "$MSG_COL_REPO" "$MSG_COL_STATUS"
    printf "${GRAY}%-25s %-35s %s${NC}\n" "-------" "----------" "------"
    while IFS='|' read -r pkg repo || [ -n "$pkg" ]; do
      [[ "$pkg" =~ ^#.* ]] && continue
      [ -z "$pkg" ] && continue
      status="${GREEN}${MSG_STATUS_ACTIVE}${NC}"
      if apt-mark showhold 2>/dev/null | grep -qx "$pkg"; then
        status="${YELLOW}${MSG_STATUS_PINNED}${NC}"
      fi
      printf "${CYAN}%-25s${NC} %-35s %b\n" "$pkg" "$repo" "$status"
    done < "$SOURCES_FILE"
    ;;

  remove|-r)
    PKG="$2"
    echo -e "${BLUE}---------------------------------------${NC}"
    [ -z "$PKG" ] && { echo -e "${YELLOW}${MSG_USAGE_REMOVE}${NC}"; exit 1; }

    if [ "$DRY_RUN" = "true" ]; then
      printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_REMOVE_TRACK" "${CYAN}${PKG}${YELLOW}" "${SOURCES_FILE}")"
      printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_REMOVE_APT" "${PKG}")"
      echo -e "${BLUE}---------------------------------------${NC}"
      exit 0
    fi

    if [ -f "$SOURCES_FILE" ] && grep -q "^${PKG}|" "$SOURCES_FILE" 2>/dev/null; then
      $ELEVATE sed -i "/^${PKG}|/d" "$SOURCES_FILE"
      printf "${GREEN}%b${NC}\n" "$(printf "$MSG_REMOVE_TRACK_SUCCESS" "${PKG}")"
    fi

    printf "${BLUE}::${NC} ${CYAN}%b${NC}\n" "$(printf "$MSG_APT_PURGING" "${PKG}")"
    if run_apt_styled purge -y "$PKG"; then
      printf "${GREEN}✔ %b${NC}\n" "$(printf "$MSG_APT_PURGE_SUCCESS" "${PKG}")"
    else
      printf "${RED}✖ %b${NC}\n" "$(printf "$MSG_APT_PURGE_FAIL" "${PKG}")"
    fi
    ;;

  pin|-p)
    PKG="$2"
    echo -e "${BLUE}---------------------------------------${NC}"
    [ -z "$PKG" ] && { echo -e "${YELLOW}${MSG_USAGE_PIN}${NC}"; exit 1; }
    if [ "$DRY_RUN" = "true" ]; then
      printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_PIN" "${PKG}")"
      exit 0
    fi
    if $ELEVATE apt-mark hold "$PKG"; then
      printf "${GREEN}%b${NC}\n" "$(printf "$MSG_PIN_SUCCESS" "${PKG}")"
    fi
    ;;

  unpin|-n)
    PKG="$2"
    echo -e "${BLUE}---------------------------------------${NC}"
    [ -z "$PKG" ] && { echo -e "${YELLOW}${MSG_USAGE_UNPIN}${NC}"; exit 1; }
    if [ "$DRY_RUN" = "true" ]; then
      printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_DRY_UNPIN" "${PKG}")"
      exit 0
    fi
    if $ELEVATE apt-mark unhold "$PKG"; then
      printf "${GREEN}%b${NC}\n" "$(printf "$MSG_UNPIN_SUCCESS" "${PKG}")"
    fi
    ;;

  token|auth|ghtoken|-t)
    shift
    set_github_token "$1"
    ;;

  search|-s)
    shift
    debup_search "$*"
    ;;

  info|show|-f)
    debup_info "$2"
    ;;

  inspect|audit|-I)
    shift
    debup_inspect "$1"
    ;;

  "")
    "$0" update && "$0" upgrade
    ;;

  stats|--stats|-S)
    debup_stats
    ;;

  clean|-c)
    debup_clean
    ;;

  -Syu|-Syyu|-syu)
    printf "I use ${RED}Debian${NC} btw.\n"
    printf "All the stability of ${RED}Debian${NC}, all the speed and comfort of ${BLUE}Arch${NC}.\n"
    "$0" update && "$0" upgrade
    ;;

  help|-h|--help|--show-help)
    show_banner
    echo -e "${BOLD}${MSG_HELP_SEC_PKG}${NC}"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-i, install, -a, add [-y] <repo>" "$MSG_HELP_ADD"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-u, upgrade [-y]"               "$MSG_HELP_UPGRADE"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-r, remove <pkg>"                 "$MSG_HELP_REMOVE"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n\n" "-p, pin | -n, unpin <pkg>"      "$MSG_HELP_PIN"

    echo -e "${BOLD}${MSG_HELP_SEC_DISCOVERY}${NC}"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-s, search <query>"               "$MSG_HELP_SEARCH"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-f, info <repo>"                  "$MSG_HELP_INFO"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-l, list"                         "$MSG_HELP_LIST"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-S, stats"                        "$MSG_HELP_STATS"

    echo -e "${BOLD}${MSG_HELP_SEC_CONFIG}${NC}"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n\n" "-t, auth, token [PAT]"          "$MSG_HELP_AUTH"

    echo -e "${BOLD}${MSG_HELP_SEC_OPTIONS}${NC}"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-d, --dry-run"                    "$MSG_HELP_DRY"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-I, inspect, audit <repo>"        "${HELP_INSPECT_DESC}"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-c, clean"                        "${MSG_HELP_CLEAN:-Clean APT cache and leftover files}"
    printf "  ${CYAN}%-32s${NC} ${GRAY}%s${NC}\n" "-h, help"                         "$MSG_HELP_HELP"
    ;;

  *)
    cmd_name="$(basename "$0")"
    printf "${RED}%b${NC}\n" "$(printf "$MSG_ERR_UNKNOWN_CMD" "$1")"
    printf "${YELLOW}%b${NC}\n" "$(printf "$MSG_RUN_HELP_HINT" "$cmd_name")"
    exit 1
    ;;
esac