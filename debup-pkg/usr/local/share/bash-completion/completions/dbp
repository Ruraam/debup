_debup_completions() {
local cur prev commands
cur="${COMP_WORDS[COMP_CWORD]}"
prev="${COMP_WORDS[COMP_CWORD-1]}"

commands="add install update upgrade remove pin unpin list search info show token auth ghtoken help -a -u -r-p -n -l -s -i -t -h --help -d --dry-run -y --yes"

case "$prev" in
remove|-r|pin|-p|unpin|-n)
local sources_file="/etc/debup/sources.list"
if [ -f "$sources_file" ]; then
local pkgs
pkgs=$(cut -d'|'-f1 "$sources_file" 2>/dev/null | grep -v '^#')
COMPREPLY=($(compgen -W "$pkgs" -- "$cur") )
fi
return 0
;;

add|install|-a|search|-s|info|show|-i|token|auth|ghtoken|-t)
return 0
;;

debup|dbp)
COMPREPLY=( $(compgen -W "$commands" -- "$cur") )
return 0
;;

*)
COMPREPLY=( $(compgen -W"$commands" -- "$cur") )
return 0
;;
esac
}

complete -F _debup_completions debup
complete -F _debup_completions dbp