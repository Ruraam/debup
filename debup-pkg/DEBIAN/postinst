#!/usr/bin/env bash
#
# debup package post-installation configuration.
#

set -Eeuo pipefail
umask 022

readonly CONF_DIR="/etc/debup"
readonly SOURCES_FILE="${CONF_DIR}/sources.list"
readonly TRACKED_SOURCE="debup|https://github.com/Ruraam/debup"

case "${1:-}" in
    configure)
        install -d -m 0755 "$CONF_DIR"

        tmp_sources="$(mktemp "${CONF_DIR}/.sources.list.XXXXXX")"
        cleanup() {
            [[ -z "${tmp_sources:-}" ]] || rm -f -- "$tmp_sources"
        }
        trap cleanup EXIT

        if [[ -f "$SOURCES_FILE" ]]; then
            # Migrate the legacy short repository form and avoid duplicate entries.
            awk -F'|' '
                !($1 == "debup" && ($2 == "Ruraam/debup" || $2 == "https://github.com/Ruraam/debup"))
            ' "$SOURCES_FILE" > "$tmp_sources"
        fi

        printf '%s\n' "$TRACKED_SOURCE" >> "$tmp_sources"
        chmod 0644 "$tmp_sources"
        mv -f -- "$tmp_sources" "$SOURCES_FILE"
        tmp_sources=""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        printf 'postinst called with invalid argument: %s\n' "${1:-<missing>}" >&2
        exit 1
        ;;
esac

exit 0
